      "type": "apiarian-founder-story",
      "name": "Apiarian Founder Story",
      "settings": {
        "main_image": "shopify://shop_images/3b510f7b-18b4-437c-a296-1c9130380600.jpg",
        "small_image": "shopify://shop_images/d89e7733-b0c9-4e2f-ba6a-b9e631e7c6f7.jpg",
        "eyebrow": "THE PERSON BEHIND IT",
