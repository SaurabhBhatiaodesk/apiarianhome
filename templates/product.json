    "apiarian_good_to_know_GfbiQc": {
      "type": "apiarian-good-to-know",
      "blocks": {
        "item_PEUpDM": {
          "type": "item",
          "settings": {
            "question": "Shipping",
            "answer": "<p>Orders leave Fort Collins within two business days. Free U.S. shipping over $60, flat $6 below that.</p>"
          }
        },
        "item_gaPntm": {
          "type": "item",
          "settings": {
            "question": "Returns",
            "answer": "<p>Unopened bottles can come back within 30 days. If a bottle arrives damaged, we replace it and cover the postage.</p>"
          }
        },
        "item_gK9xtQ": {
          "type": "item",
          "settings": {
            "question": "Is it safe around pets?",
            "answer": "<p>Spray fabric, not animals, and let the room air for a few minutes. Cats are sensitive to some essential oils, so keep them out of the room while it dries.</p>"
          }
        },
        "item_cPyzjb": {
          "type": "item",
          "settings": {
            "question": "Where should I spray it?",
            "answer": "<p>Linen, curtains, upholstery and the inside of a closet. It is a room and fabric spray, not a perfume for skin.</p>"
          }
        },
        "item_TRdXmF": {
          "type": "item",
          "settings": {
            "question": "How long does a bottle last?",
            "answer": "<p>A 100 mL bottle runs about three months at a few sprays a day. Kept out of sunlight, an opened bottle holds for a year.</p>"
          }
        },
        "item_dR4xXQ": {
          "type": "item",
          "settings": {
            "question": "Do you offer refills?",
            "answer": "<p>Yes. Bring or post the glass bottle back and we refill it at a discount, wooden cap and all.</p>"
          }
        }
      },
      "block_order": [
        "item_PEUpDM",
