ton_text_size":15,"mobile_note_size":13,"mobile_heading_bottom_spacing":20,"mobile_text_bottom_spacing":26,"mobile_action_gap":14}},"apiarian_role_split_banner_q8Jgn7":{"type":"apiarian-role-split-banner","name":"Apiarian role split","settings":{"metafield_namespace":"custom","metafield_key":"the_role_in_the_colony","metaobject_type":"the_role_in_the_colony","section_background":"#fffcf6","eyebrow_size":18,"eyebrow_letter_spacing":3,"heading_size":50,"text_size":20,"content_max_width":600,"content_padding_vertical":160,"content_padding_horizontal":60,"border_radius":20,"padding_top":20,"padding_bottom":20,"mobile_eyebrow_size":14,"mobile_eyebrow_letter_spacing":4,"mobile_heading_size":34,"mobile_text_size":16,"mobile_content_padding_vertical":35,"mobile_content_padding_horizontal":24,"mobile_border_radius":20,"mobile_padding_top":20,"mobile_padding_bottom":20}},"apiarian_ingredients_sourcing_JfrKaA":{"type":"apiarian-ingredients-sourcing","blocks":{"ingredient_g9iaCy":{"type":"ingredient","settings":{"title":"Beeswax absolute","text":"<p>Rendered from Netta’s own frames. It anchors the blend and slows evaporation.<\/p>"}},"ingredient_rVe6hr":{"type":"ingredient","settings":{"title":"Organic sugarcane alcohol","text":"<p>The carrier. It flashes off and leaves the oils on the fabric.<\/p>"}},"ingredient_7XjrLF":{"type":"ingredient","settings":{"title":"Essential oils and absolutes","text":"<p>Resins first, warmed by benzoin. Nothing about it is sharp for long.<\/p>"}},"ingredient_azmQfG":{"type":"ingredient","settings":{"title":"Nothing else","text":"<p>No synthetic fragrance, no fixatives, no dyes, no phthalates.<\/p>"}}},"block_order":["ingredient_g9iaCy","ingredient_rVe6hr","ingredient_7XjrLF","ingredient_azmQfG"],"name":"Ingredients & sourcing","settings":{"eyebrow":"INGREDIENTS & SOURCING","heading":"Four things,","heading_italic":"nothing hidden.","text":"<p>Every bottle is blended by hand in Fort Collins, in batches small enough that each one carries its own character.<\/p>","eyebrow_color":"#8a6a1f","heading_color":"#2a2118","text_color":"#2a2118","card_background":"#f4eee1","card_title_color":"#17100b","card_text_color":"#2a2118","left_width":46,"column_gap":70,"card_gap":16,"card_min_height":160,"card_radius":16,"card_padding_vertical":32,"card_padding_horizontal":32,"spacing_top":80,"spacing_bottom":80,"eyebrow_size":15,"eyebrow_letter_spacing":5,"heading_size":50,"text_size":18,"card_title_size":20,"card_text_size":16,"eyebrow_bottom_spacing":16,"heading_bottom_spacing":20,"card_title_bottom_spacing":12,"mobile_spacing_top":50,"mobile_spacing_bottom":50,"mobile_heading_size":38,"mobile_eyebrow_size":13,"mobile_eyebrow_letter_spacing":4,"mobile_text_size":16,"mobile_card_title_size":18,"mobile_card_text_size":15,"mobile_card_gap":14,"mobile_card_radius":18,"mobile_card_padding_vertical":24,"mobile_card_padding_horizontal":24}},"apiarian_values_bhcEQQ":{"type":"apiarian-values","blocks":{"item_hQzQtg":{"type":"item","settings":{"number":"01","heading":"Shake, then spray","text":"<p>Beeswax settles between uses. A short shake puts it back through the blend.<\/p>"}},"item_c34xDe":{"type":"item","settings":{"number":"02","heading":"Aim at fabric","text":"<p>Linen, curtains and upholstery hold the scent longest. Two or three passes is plenty.<\/p>"}},"item_VgnR7g":{"type":"item","settings":{"number":"03","heading":"Let it settle","text":"<p>Give it an hour before you judge it. The wax keeps working long after the top notes go.<\/p>"}}},"block_order":["item_hQzQtg","item_c34xDe","item_VgnR7g"],"name":"Apiarian Values","settings":{"bee_image":"shopify:\/\/shop_images\/bcf2a5f9-f2ff-4b4b-8ce1-d8ac93a318d4.png","bee_width":70,"section_background":"#fffcf6","box_background":"#efe8da","number_background":"#f5d991","number_color":"#21170f","heading_color":"#21170f","text_color":"#2a2118","box_radius":24,"padding_top":0,"padding_bottom":55,"mobile_padding_top":35,"mobile_padding_bottom":35}},"apiarian_kind_words_prxhUq":{"type":"a