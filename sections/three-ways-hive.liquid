{% style %}
#shopify-section-{{ section.id }} {
  background: {{ section.settings.section_background }};
}

#shopify-section-{{ section.id }} .apiarian-entry-cards,
#shopify-section-{{ section.id }} .apiarian-entry-cards * {
  box-sizing: border-box;
}

#shopify-section-{{ section.id }} .apiarian-entry-cards {
  width: 100%;
  padding:
    {{ section.settings.padding_top }}px
    0
    {{ section.settings.padding_bottom }}px;
}

#shopify-section-{{ section.id }} .apiarian-entry-cards__header {
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.7fr);
  gap: 64px;
  align-items: end;
  margin-bottom: 42px;
}

#shopify-section-{{ section.id }} .apiarian-entry-cards__heading {
  margin: 0;
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight:300;
  line-height: 1.04;
  letter-spacing: -1.8px;
}

#shopify-section-{{ section.id }} .apiarian-entry-cards__heading em,
#shopify-section-{{ section.id }} .apiarian-entry-cards__heading i {
  font-family: "Bodoni Moda", serif;
  font-style: italic;
  font-weight: 400;
}

#shopify-section-{{ section.id }} .apiarian-entry-cards__intro {
  max-width: 490px;
  margin: 0 0 3px auto;
  color: {{ section.settings.intro_color }};
  font-size: {{ section.settings.intro_size }}px;
  font-weight:300;
  line-height:normal;
}

#shopify-section-{{ section.id }} .apiarian-entry-cards__intro p {
  margin: 0;
}

#shopify-section-{{ section.id }} .apiarian-entry-cards__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: {{ section.settings.card_gap }}px;
}

#shopify-section-{{ section.id }} .apiarian-entry-card {
  position: relative;
  display: block;
  min-width: 0;
  overflow: hidden;
  aspect-ratio: 0.86;
  border-radius: {{ section.settings.card_radius }}px;
  background: {{ section.settings.card_background }};
  color: {{ section.settings.card_text_color }};
  text-decoration: none;
  isolation: isolate;
}

#shopify-section-{{ section.id }} .apiarian-entry-card::after {
  content: "";
  position: absolute;
  top: -20%;
  bottom: -20%;
  left: -55%;
  z-index: 4;
  width: 34%;
  background: linear-gradient(
    105deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.08) 35%,
    rgba(255, 255, 255, 0.34) 50%,
    rgba(255, 255, 255, 0.08) 65%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: skewX(-18deg);
  pointer-events: none;
  transition: left 0.85s cubic-bezier(0.22, 1, 0.36, 1);
}

@media (hover: hover) and (pointer: fine) {
  #shopify-section-{{ section.id }} .apiarian-entry-card:hover::after {
    left: 125%;
  }
}

#shopify-section-{{ section.id }} .apiarian-entry-card__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}

#shopify-section-{{ section.id }} .apiarian-entry-card__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
}

#shopify-section-{{ section.id }} .apiarian-entry-card:hover .apiarian-entry-card__image {
  transform: scale(1.025);
}

#shopify-section-{{ section.id }} .apiarian-entry-card__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  display:block;
  background:
    linear-gradient(
      to top,
      rgba(18, 12, 7, {{ section.settings.overlay_bottom_opacity | divided_by: 100.0 }}) 0%,
      rgba(18, 12, 7, 0.32) 42%,
      rgba(18, 12, 7, 0.04) 72%,
      rgba(18, 12, 7, 0) 100%
    );
  pointer-events: none;
}

#shopify-section-{{ section.id }} .apiarian-entry-card__content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding: 34px 38px 36px;
}

#shopify-section-{{ section.id }} .apiarian-entry-card__title {
  margin: 0 0 12px;
  color: {{ section.settings.card_text_color }};
  font-size: {{ section.settings.card_title_size }}px;
  font-weight: 400;
  line-height: 1.12;
}

#shopify-section-{{ section.id }} .apiarian-entry-card__text {
  margin: 0;
  color: {{ section.settings.card_text_color }};
  font-size: {{ section.settings.card_text_size }}px;
  font-weight: 300;
  line-height: 1.45;
}

#shopify-section-{{ section.id }} .apiarian-entry-card__text p {
  margin: 0;
}

#shopify-section-{{ section.id }} .apiarian-entry-card__cta {
  display: inline-block;
  color: {{ section.settings.cta_color }};
  font-size: {{ section.settings.cta_size }}px;
  font-weight: 400;
  line-height: 1.2;
  letter-spacing: 2.7px;
  text-transform: uppercase;
}

#shopify-section-{{ section.id }} .apiarian-entry-card__placeholder {
  position: absolute;
  inset: 0;
  background: #d8d2c8;
}



/* =========================
   PAGE ON SCROLL ANIMATION
========================= */

#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-cards__heading,
#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-cards__intro,
#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-card {
  opacity: 0;
  transform: translateY(26px);
  will-change: opacity, transform;
}

#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-cards__heading {
  transition:
    opacity 0.55s ease 0s,
    transform 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0s;
}

#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-cards__intro {
  transition:
    opacity 0.55s ease 0.08s,
    transform 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.08s;
}

#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-card {
  transition:
    opacity 0.55s ease,
    transform 0.78s cubic-bezier(0.22, 1, 0.36, 1);
}

#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-card:nth-child(1) {
  transition-delay: 0.14s;
}

#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-card:nth-child(2) {
  transition-delay: 0.22s;
}

#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready
.apiarian-entry-card:nth-child(3) {
  transition-delay: 0.30s;
}

#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready.is-visible
.apiarian-entry-cards__heading,
#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready.is-visible
.apiarian-entry-cards__intro,
#shopify-section-{{ section.id }}
.apiarian-entry-cards.is-animation-ready.is-visible
.apiarian-entry-card {
  opacity: 1;
  transform: translateY(0);
}

/* =========================
   TABLET
========================= */

@media screen and (max-width: 989px) {
  #shopify-section-{{ section.id }} .apiarian-entry-cards__header {
    grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr);
    gap: 36px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-cards__heading {
    font-size: calc({{ section.settings.heading_size }}px * 0.78);
  }

  #shopify-section-{{ section.id }} .apiarian-entry-cards__grid {
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-card__content {
    padding: 26px 24px 28px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-card__title {
    font-size: calc({{ section.settings.card_title_size }}px * 0.88);
  }
}


/* =========================
   MOBILE
========================= */

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .apiarian-entry-cards {
    padding:
      {{ section.settings.mobile_padding_top }}px
      0
      {{ section.settings.mobile_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-cards__header {
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-cards__heading {
    font-size: {{ section.settings.mobile_heading_size }}px;
    line-height: 1.06;
    letter-spacing: -1px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-cards__intro {
    max-width: 100%;
    margin: 0;
    font-size: {{ section.settings.mobile_intro_size }}px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-cards__grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-card {
    aspect-ratio: 0.92;
    border-radius: 22px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-card__content {
    padding: 26px 24px 28px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-card__title {
    margin-bottom: 9px;
    font-size: {{ section.settings.mobile_card_title_size }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-card__text {
    font-size: {{ section.settings.mobile_card_text_size }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-entry-card__cta {
    font-size: {{ section.settings.mobile_cta_size }}px;
    letter-spacing: 2.2px;
  }
}


/* =========================
   REDUCED MOTION
========================= */

@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .apiarian-entry-card__image,
  #shopify-section-{{ section.id }} .apiarian-entry-card::after {
    transition: none;
  }

  #shopify-section-{{ section.id }}
  .apiarian-entry-cards.is-animation-ready
  .apiarian-entry-cards__heading,
  #shopify-section-{{ section.id }}
  .apiarian-entry-cards.is-animation-ready
  .apiarian-entry-cards__intro,
  #shopify-section-{{ section.id }}
  .apiarian-entry-cards.is-animation-ready
  .apiarian-entry-card {
    opacity: 1;
    transform: none;
    transition: none;
    will-change: auto;
  }
}
{% endstyle %}


<section class="apiarian-entry-cards" data-apiarian-entry-cards>
  <div class="page-width">

    <div class="apiarian-entry-cards__header">
      {% if section.settings.heading != blank %}
        <div class="apiarian-entry-cards__heading">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.intro != blank %}
        <div class="apiarian-entry-cards__intro">
          {{ section.settings.intro }}
        </div>
      {% endif %}
    </div>

    <div class="apiarian-entry-cards__grid">
      {% for block in section.blocks %}
        {%- liquid
          assign card_link = block.settings.link
          assign card_image = block.settings.image
          assign card_title = block.settings.title

          if block.settings.collection != blank
            if card_link == blank
              assign card_link = block.settings.collection.url
            endif

            if card_image == blank and block.settings.collection.featured_image != blank
              assign card_image = block.settings.collection.featured_image
            endif

            if card_title == blank
              assign card_title = block.settings.collection.title
            endif
          endif
        -%}

        <a
          class="apiarian-entry-card"
          href="{{ card_link | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          <div class="apiarian-entry-card__media">
            {% if card_image != blank %}
              {{
                card_image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '420, 640, 820, 1000, 1200, 1400',
                  sizes: '(max-width: 749px) 100vw, 33vw',
                  class: 'apiarian-entry-card__image',
                  alt: card_image.alt
              }}
            {% else %}
              <div class="apiarian-entry-card__placeholder"></div>
            {% endif %}
          </div>

          <div class="apiarian-entry-card__overlay"></div>

          <div class="apiarian-entry-card__content">
            {% if card_title != blank %}
              <h3 class="apiarian-entry-card__title">
                {{ card_title | escape }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="apiarian-entry-card__text">
                {{ block.settings.text }}
              </div>
            {% endif %}

            {% if block.settings.cta != blank %}
              <span class="apiarian-entry-card__cta">
                {{ block.settings.cta | escape }}
              </span>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>

  </div>
</section>



<script>
  (function () {
    function initApiarianEntryCards() {
      const section = document.querySelector(
        '#shopify-section-{{ section.id }} [data-apiarian-entry-cards]'
      );

      if (!section || section.dataset.apiarianEntryCardsInitialized === 'true') {
        return;
      }

      section.dataset.apiarianEntryCardsInitialized = 'true';

      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        return;
      }

      const rect = section.getBoundingClientRect();
      const viewportHeight =
        window.innerHeight ||
        document.documentElement.clientHeight;

      /*
       * If already visible/very close at initial load, show immediately.
       * This keeps both desktop and mobile feeling fast.
       */
      if (rect.top <= viewportHeight * 1.08) {
        return;
      }

      section.classList.add('is-animation-ready');

      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.10,
          rootMargin: '0px 0px 70px 0px'
        }
      );

      observer.observe(section);
    }

    initApiarianEntryCards();

    document.addEventListener('shopify:section:load', function (event) {
      if (
        event.target &&
        event.target.id === 'shopify-section-{{ section.id }}'
      ) {
        const section = event.target.querySelector(
          '[data-apiarian-entry-cards]'
        );

        if (section) {
          delete section.dataset.apiarianEntryCardsInitialized;
          section.classList.remove('is-animation-ready', 'is-visible');
        }

        initApiarianEntryCards();
      }
    });
  })();
</script>

