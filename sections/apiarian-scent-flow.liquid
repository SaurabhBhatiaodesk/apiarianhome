<section
  class="apiarian-scent-flow"
  data-apiarian-scent-flow
>
  <div class="page-width">
    <div class="apiarian-scent-flow__layout">

      <div class="apiarian-scent-flow__left">

        {% if section.settings.eyebrow != blank %}
          <p class="apiarian-scent-flow__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="apiarian-scent-flow__heading">
            {{ section.settings.heading }}
          </div>
        {% endif %}

      {% if section.settings.intro_text != blank %}
        <div class="apiarian-scent-flow__intro">
          {{ section.settings.intro_text }}

          {% if section.settings.bee_image_two != blank %}
            <span class="apiarian-scent-flow__bee apiarian-scent-flow__bee--two">
              {{
                section.settings.bee_image_two
                | image_url: width: 260
                | image_tag:
                  loading: 'lazy', 
                  decoding: 'async',
                  widths: '80, 120, 160, 220, 260',
                  alt: ''
              }}
            </span>
          {% endif %}
        </div>
      {% endif %}

        {% if section.settings.bee_image_one != blank or section.settings.bee_image_two != blank or section.settings.bee_image_three != blank %}
          <div class="apiarian-scent-flow__bees" aria-hidden="true">

            {% if section.settings.bee_image_one != blank %}
              <div class="apiarian-scent-flow__bee apiarian-scent-flow__bee--one">
                {{
                  section.settings.bee_image_one
                  | image_url: width: 320
                  | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    widths: '80, 120, 160, 220, 320',
                    alt: ''
                }}
              </div>
            {% endif %}



            {% if section.settings.bee_image_three != blank %}
              <div class="apiarian-scent-flow__bee apiarian-scent-flow__bee--three">
                {{
                  section.settings.bee_image_three
                  | image_url: width: 220
                  | image_tag:
                    loading: 'lazy',
                    decoding: 'async',
                    widths: '60, 90, 120, 160, 220',
                    alt: ''
                }}
              </div>
            {% endif %}

          </div>
        {% endif %}

      </div>


      <div class="apiarian-scent-flow__timeline">

        {% for block in section.blocks %}
          <div
            class="apiarian-scent-flow__row"
            {{ block.shopify_attributes }}
          >

            <div class="apiarian-scent-flow__label">
              {{ block.settings.label | escape }}
            </div>

            <div class="apiarian-scent-flow__content">

              {% if block.settings.heading != blank %}
                <h3 class="apiarian-scent-flow__row-title">
                  {{ block.settings.heading | escape }}
                </h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="apiarian-scent-flow__row-text">
                  {{ block.settings.text }}
                </div>
              {% endif %}

            </div>

          </div>
        {% endfor %}

      </div>

    </div>
  </div>
</section>


<script>
  (function () {
    function initApiarianScentFlow() {
      const section = document.querySelector(
        '#shopify-section-{{ section.id }} [data-apiarian-scent-flow]'
      );

      if (!section || section.dataset.apiarianScentFlowInitialized === 'true') {
        return;
      }

      section.dataset.apiarianScentFlowInitialized = 'true';

      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        return;
      }

      const rect = section.getBoundingClientRect();
      const viewportHeight =
        window.innerHeight ||
        document.documentElement.clientHeight;

      if (rect.top <= viewportHeight * 1.08) {
        return;
      }

      section.classList.add('is-animation-ready');

      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px 70px 0px'
        }
      );

      observer.observe(section);
    }

    initApiarianScentFlow();

    document.addEventListener('shopify:section:load', function (event) {
      if (
        event.target &&
        event.target.id === 'shopify-section-{{ section.id }}'
      ) {
        const section = event.target.querySelector(
          '[data-apiarian-scent-flow]'
        );

        if (section) {
          delete section.dataset.apiarianScentFlowInitialized;
          section.classList.remove('is-animation-ready', 'is-visible');
        }

        initApiarianScentFlow();
      }
    });
  })();
</script>


{% schema %}
