{% style %}
#shopify-section-{{ section.id }} {
  background: {{ section.settings.section_background }};
}

#shopify-section-{{ section.id }} .apiarian-scent-flow,
#shopify-section-{{ section.id }} .apiarian-scent-flow * {
  box-sizing: border-box;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow {
  width: 100%;
  padding:
    {{ section.settings.padding_top }}px
    0
    {{ section.settings.padding_bottom }}px;
  color: {{ section.settings.text_color }};
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.18fr);
  gap:72px;
  align-items: start;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__left {
  position: relative;
  min-width: 0;
  padding-top: 8px;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__eyebrow {
  margin: 0 0 24px;
  color: {{ section.settings.eyebrow_color }};
  font-size: 14px;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0.28em;
  text-transform: uppercase;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__heading {
  max-width: 760px;
  margin: 0;
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight:300;
  line-height: 1.05;
  letter-spacing: -1.6px;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__heading em,
#shopify-section-{{ section.id }} .apiarian-scent-flow__heading i {
  font-family: "Bodoni Moda", serif;
  font-style: italic;
  font-weight: 400;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__intro {
  max-width: 539px;
  margin-top: 17px;
  color: {{ section.settings.body_color }};
    font-size: 19px;
    font-weight: 300;
   line-height: 1.62;
   position:relative;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__intro p {
  margin: 0;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__bees {
  position: relative;
  width: 100%;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__bee {
  position: absolute;
  display: block;
  z-index: 2;
  line-height: 0;
  opacity: 1;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__bee img {
  display: block;
  width: 100%;
  height: auto;
  opacity: 0.5;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__bee--one {
  width: 48px;
  right:0;
  top: -25px;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__bee--one img {
  transform: rotate(323deg);
  width: 49px;
  height: 48px;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__bee--two {
    right: 22%;
    top: -6px;
}
#shopify-section-{{ section.id }} .apiarian-scent-flow__bee--two img {
    width: 17px;
    height: 22px;
    opacity: 0.32;
    transform:rotate(-38deg);
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__bee--three {
    width: 30px;
    right: 3%;
    top: 35px;
    height: 30px;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__bee--three img {
      transform: rotate(-34deg);
    opacity: 0.4;
    width: 23px;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__timeline {
  min-width: 0;
  border-top: 1px solid {{ section.settings.border_color }};
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__row {
  display: grid;
  grid-template-columns: 145px minmax(0, 1fr);
  gap: 28px;
  padding: 27px 0 28px;
  border-bottom:0.5px solid {{ section.settings.border_color }};
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__label {
  padding-top: 3px;
  color: {{ section.settings.eyebrow_color }};
  font-size: 13.9515px;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 3px;
  text-transform: uppercase;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__row-title {
  margin: 0 0 10px;
  color: {{ section.settings.heading_color }};
  font-size:19.1677px;
  font-weight:400;
  line-height: 1.25;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__row-text {
  margin: 0;
  color: {{ section.settings.body_color }};
    font-size: 16px;
    font-weight: 300;
    line-height: normal;
}

#shopify-section-{{ section.id }} .apiarian-scent-flow__row-text p {
  margin: 0;
}


/* =========================
   PAGE ON SCROLL ANIMATION
========================= */

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__eyebrow,
#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__heading,
#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__intro,
#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__bee,
#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__row {
  opacity: 0;
  transform: translateY(22px);
  will-change: opacity, transform;
}

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__eyebrow {
  transition:
    opacity 0.5s ease 0s,
    transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0s;
}

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__heading {
  transition:
    opacity 0.55s ease 0.08s,
    transform 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.08s;
}

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__intro {
  transition:
    opacity 0.5s ease 0.16s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.16s;
}

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__bee {
  transition:
    opacity 0.5s ease 0.22s,
    transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.22s;
}

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__row:nth-child(1) {
  transition:
    opacity 0.5s ease 0.10s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.10s;
}

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__row:nth-child(2) {
  transition:
    opacity 0.5s ease 0.18s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.18s;
}

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready
.apiarian-scent-flow__row:nth-child(3) {
  transition:
    opacity 0.5s ease 0.26s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.26s;
}

#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready.is-visible
.apiarian-scent-flow__eyebrow,
#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready.is-visible
.apiarian-scent-flow__heading,
#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready.is-visible
.apiarian-scent-flow__intro,
#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready.is-visible
.apiarian-scent-flow__bee,
#shopify-section-{{ section.id }}
.apiarian-scent-flow.is-animation-ready.is-visible
.apiarian-scent-flow__row {
  opacity: 1;
  transform: translateY(0);
}


