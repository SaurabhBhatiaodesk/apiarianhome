{% style %}

  /* =========================================================
     SECTION
  ========================================================= */

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_background }};
  }

  #shopify-section-{{ section.id }} .apiarian-impact {
    position: relative;
    width: 100%;

    padding:
      {{ section.settings.padding_top }}px
      0
      {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-impact,
  #shopify-section-{{ section.id }} .apiarian-impact * {
    box-sizing: border-box;
  }


  /* =========================================================
     BANNER
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__banner {
    position: relative;

    display: flex;
    align-items: center;

    width: 100%;

    overflow: hidden;

    background-color: {{ section.settings.fallback_background }};
    border-radius: {{ section.settings.border_radius }}px;

    isolation: isolate;
  }


  /* =========================================================
     BACKGROUND IMAGE
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__media {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    z-index: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-impact__image {
    position: absolute;
    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    max-width: none;

    object-fit: cover;
    object-position: {{ section.settings.desktop_image_position }};

    opacity: 1;
    visibility: visible;
  }


  /* =========================================================
     OVERLAY
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__overlay {
    position: absolute;
    inset: 0;
    display:block;
    z-index: 1;

    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};

    pointer-events: none;
  }


  /* =========================================================
     CONTENT
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__content {
    position: relative;

    z-index: 2;

    width: 100%;
    max-width: {{ section.settings.content_width }}px;

    padding:
      {{ section.settings.content_padding_vertical }}px
      {{ section.settings.content_padding_horizontal }}px;
  }


  /* =========================================================
     EYEBROW
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__eyebrow {
    margin: 0 0 26px;

    color: {{ section.settings.eyebrow_color }};

    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 400;
    line-height: 1.3;

    letter-spacing: 4px;
    text-transform: uppercase;
  }


  /* =========================================================
     HEADING
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__heading {
    margin: 0 0 24px;

    color: {{ section.settings.heading_color }};

    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;

    line-height: 1.08;
    letter-spacing: -1px;
  }

  #shopify-section-{{ section.id }} .apiarian-impact__heading em,
  #shopify-section-{{ section.id }} .apiarian-impact__heading i {
    font-style: italic;
    font-weight: 400;
    font-family: "Bodoni Moda", serif;
  }


  /* =========================================================
     DESCRIPTION
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__text {
    width: 100%;

    color: {{ section.settings.text_color }};

    font-size: {{ section.settings.text_size }}px;
    font-weight: 400;

    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .apiarian-impact__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }}
    .apiarian-impact__text p + p {
    margin-top: 5px;
  }


  /* =========================================================
     BUTTON
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__button-wrap {
    margin-top: 28px;
  }

  #shopify-section-{{ section.id }} .apiarian-impact__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: {{ section.settings.button_height }}px;

    padding: 12px 34px;

    border: 1px solid {{ section.settings.button_background }};
    border-radius: 999px;

    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text }};

    text-decoration: none;

    font-size: 15px;
    font-weight: 400;
    line-height: 1;

    cursor: pointer;

    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }

  #shopify-section-{{ section.id }}
    .apiarian-impact__button:hover {
    background-color: {{ section.settings.button_hover_background }};
    border-color: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text }};

    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }}
    .apiarian-impact__button:active {
    transform: translateY(0);
  }


  /* =========================================================
     DECORATION
  ========================================================= */

  #shopify-section-{{ section.id }} .apiarian-impact__decoration {
    position: absolute;

    top: {{ section.settings.decoration_top }}px;
    left: {{ section.settings.decoration_position }}%;

    width: {{ section.settings.decoration_width }}px;

    z-index: 5;

    pointer-events: none;

    transform:
      translateX(-50%)
      rotate({{ section.settings.decoration_rotation }}deg);
  }

  #shopify-section-{{ section.id }}
    .apiarian-impact__decoration img {
    display: block;

    width: 100%;
    height: auto;
  }


  /* =========================================================
     LIGHTWEIGHT SCROLL ANIMATION

     Banner and image always remain visible.
  ========================================================= */

  #shopify-section-{{ section.id }}
    .apiarian-impact.is-animation-ready
    .apiarian-impact__eyebrow {
    opacity: 0;
    transform: translateY(12px);

    transition:
      opacity 0.4s ease,
      transform 0.55s ease;
  }

  #shopify-section-{{ section.id }}
    .apiarian-impact.is-animation-ready
    .apiarian-impact__heading {
    opacity: 0;
    transform: translateY(16px);

    transition:
      opacity 0.45s ease 0.05s,
      transform 0.6s ease 0.05s;
  }

  #shopify-section-{{ section.id }}
    .apiarian-impact.is-animation-ready
    .apiarian-impact__text {
    opacity: 0;
    transform: translateY(14px);

    transition:
      opacity 0.45s ease 0.1s,
      transform 0.6s ease 0.1s;
  }

  #shopify-section-{{ section.id }}
    .apiarian-impact.is-animation-ready
    .apiarian-impact__button-wrap {
    opacity: 0;
    transform: translateY(12px);

    transition:
      opacity 0.45s ease 0.15s,
      transform 0.6s ease 0.15s;
  }


  #shopify-section-{{ section.id }}
    .apiarian-impact.is-animation-ready.is-visible
    .apiarian-impact__eyebrow,

  #shopify-section-{{ section.id }}
    .apiarian-impact.is-animation-ready.is-visible
    .apiarian-impact__heading,

  #shopify-section-{{ section.id }}
    .apiarian-impact.is-animation-ready.is-visible
    .apiarian-impact__text,

  #shopify-section-{{ section.id }}
    .apiarian-impact.is-animation-ready.is-visible
    .apiarian-impact__button-wrap {
    opacity: 1;
    transform: translateY(0);
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media screen and (max-width: 990px) {

    #shopify-section-{{ section.id }} .apiarian-impact {
      padding-left: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .apiarian-impact__content {
      max-width: 680px;
    }

    #shopify-section-{{ section.id }} .apiarian-impact__heading {
      font-size: 46px;
    }

    #shopify-section-{{ section.id }} .apiarian-impact__text {
      font-size: 17px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .apiarian-impact {
      padding:
        {{ section.settings.mobile_padding_top }}px
        0
        {{ section.settings.mobile_padding_bottom }}px;
    }


    /* Banner */

    #shopify-section-{{ section.id }} .apiarian-impact__banner {
      align-items: flex-end;

      border-radius:
        {{ section.settings.mobile_border_radius }}px;
    }


    /* Image */

    #shopify-section-{{ section.id }} .apiarian-impact__image {
      object-position:
        {{ section.settings.mobile_image_position }};
    }


    /* Stronger mobile overlay for readability */

    #shopify-section-{{ section.id }} .apiarian-impact__overlay {
      background:
        linear-gradient(
          0deg,
          {{ section.settings.overlay_color }} 0%,
          {{ section.settings.overlay_color }} 42%,
          transparent 100%
        );

      opacity:
        {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    }


    /* Content */

    #shopify-section-{{ section.id }} .apiarian-impact__content {
      width: 100%;
      max-width: 100%;

      padding:
        {{ section.settings.mobile_content_padding_vertical }}px
        {{ section.settings.mobile_content_padding_horizontal }}px;
    }


    /* Eyebrow */

    #shopify-section-{{ section.id }} .apiarian-impact__eyebrow {
      margin-bottom: 18px;

      font-size: 12px;

      letter-spacing: 3px;
    }


    /* Heading */

    #shopify-section-{{ section.id }} .apiarian-impact__heading {
      margin-bottom: 18px;

      font-size:
        {{ section.settings.mobile_heading_size }}px;

      line-height: 1.1;

      letter-spacing: -0.5px;
    }


    /* Text */

    #shopify-section-{{ section.id }} .apiarian-impact__text {
      font-size:
        {{ section.settings.mobile_text_size }}px;

      line-height: 1.6;
    }


    /* Button */

    #shopify-section-{{ section.id }} .apiarian-impact__button-wrap {
      margin-top: 22px;
    }

    #shopify-section-{{ section.id }} .apiarian-impact__button {
      min-height:
        {{ section.settings.mobile_button_height }}px;

      padding: 11px 26px;

      font-size: 14px;
    }


    /* Decoration */

    #shopify-section-{{ section.id }}
      .apiarian-impact__decoration {
      top:
        {{ section.settings.mobile_decoration_top }}px;

      left:
        {{ section.settings.mobile_decoration_position }}%;

      width:
        {{ section.settings.mobile_decoration_width }}px;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media screen and (max-width: 400px) {

    #shopify-section-{{ section.id }} .apiarian-impact__heading {
      font-size:
        calc(
          {{ section.settings.mobile_heading_size }}px
          - 3px
        );
    }

  }


  /* =========================================================
     REDUCED MOTION
  ========================================================= */

  @media (prefers-reduced-motion: reduce) {

    #shopify-section-{{ section.id }}
      .apiarian-impact.is-animation-ready
      .apiarian-impact__eyebrow,

    #shopify-section-{{ section.id }}
      .apiarian-impact.is-animation-ready
      .apiarian-impact__heading,

    #shopify-section-{{ section.id }}
      .apiarian-impact.is-animation-ready
      .apiarian-impact__text,

    #shopify-section-{{ section.id }}
      .apiarian-impact.is-animation-ready
      .apiarian-impact__button-wrap {
      opacity: 1;
      transform: none;
      transition: none;
    }

  }

{% endstyle %}


<section
  class="apiarian-impact"
  data-apiarian-impact
>
  <div class="page-width">


  <!-- =====================================================
       DECORATION
  ====================================================== -->

  {% if section.settings.decoration_image != blank %}

    <div class="apiarian-impact__decoration">

      {{
        section.settings.decoration_image
        | image_url: width: 200
        | image_tag:
          loading: 'lazy',
          widths: '50, 75, 100, 150, 200',
          alt: section.settings.decoration_image.alt
      }}

    </div>

  {% endif %}


  <!-- =====================================================
       BANNER
  ====================================================== -->

  <div class="apiarian-impact__banner">


    <!-- ===================================================
         BACKGROUND IMAGE
    ==================================================== -->

    <div class="apiarian-impact__media">

      {% if section.settings.background_image != blank %}

        <img
          class="apiarian-impact__image"

          src="{{ section.settings.background_image | image_url: width: 1600 }}"

          srcset="
            {{ section.settings.background_image | image_url: width: 600 }} 600w,
            {{ section.settings.background_image | image_url: width: 900 }} 900w,
            {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
            {{ section.settings.background_image | image_url: width: 1600 }} 1600w,
            {{ section.settings.background_image | image_url: width: 2000 }} 2000w
          "

          sizes="100vw"

          width="{{ section.settings.background_image.width }}"
          height="{{ section.settings.background_image.height }}"

          loading="eager"

          alt="{{ section.settings.background_image.alt | escape }}"
        >

      {% endif %}

    </div>


    <!-- ===================================================
         OVERLAY
    ==================================================== -->

    <div
      class="apiarian-impact__overlay"
      aria-hidden="true"
    ></div>


    <!-- ===================================================
         CONTENT
    ==================================================== -->

    <div class="apiarian-impact__content">


      {% if section.settings.eyebrow != blank %}

        <p class="apiarian-impact__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>

      {% endif %}


      {% if section.settings.heading != blank %}

        <div class="apiarian-impact__heading">
          {{ section.settings.heading }}
        </div>

      {% endif %}


      {% if section.settings.description != blank %}

        <div class="apiarian-impact__text">
          {{ section.settings.description }}
        </div>

      {% endif %}


      {% if section.settings.button_label != blank %}

        <div class="apiarian-impact__button-wrap">

          {% if section.settings.button_link != blank %}

            <a
              href="{{ section.settings.button_link }}"
              class="apiarian-impact__button"
            >
              {{ section.settings.button_label | escape }}
            </a>

          {% else %}

            <span class="apiarian-impact__button">
              {{ section.settings.button_label | escape }}
            </span>

          {% endif %}

        </div>

      {% endif %}


    </div>

  </div>

  </div>
</section>


<script>
  (function () {

    const sectionElement = document.querySelector(
      '#shopify-section-{{ section.id }} [data-apiarian-impact]'
    );

    if (!sectionElement) return;


    if (
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
    ) {
      return;
    }


    if (!('IntersectionObserver' in window)) {
      return;
    }


    const rect =
      sectionElement.getBoundingClientRect();


    const viewportHeight =
      window.innerHeight ||
      document.documentElement.clientHeight;


    /*
     * If section is already visible:
     * show immediately.
     */

    if (rect.top <= viewportHeight * 0.92) {
      return;
    }


    /*
     * Only below-fold content animates.
     */

    sectionElement.classList.add(
      'is-animation-ready'
    );


    const observer =
      new IntersectionObserver(

        function (entries) {

          entries.forEach(function (entry) {

            if (!entry.isIntersecting) {
              return;
            }


            entry.target.classList.add(
              'is-visible'
            );


            observer.unobserve(
              entry.target
            );

          });

        },

        {
          threshold: 0.1,
          rootMargin: '0px 0px -3% 0px'
        }

      );


    observer.observe(sectionElement);

  })();
</script>


