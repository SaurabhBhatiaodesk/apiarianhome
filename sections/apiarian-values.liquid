      "type": "item",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Beeswax at the base"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Beeswax absolute anchors every blend and slows how fast the scent leaves the room.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Apiarian Values",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "number": "01",
            "heading": "Beeswax at the base",
            "text": "<p>Beeswax absolute anchors every blend and slows how fast the scent leaves the room.</p>"
          }
        },
        {
