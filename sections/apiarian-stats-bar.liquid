{% liquid
  assign section_id = 'apiarian-stats-bar-' | append: section.id
%}

<section id="{{ section_id }}" class="apiarian-stats-bar-section">
  <div class="page-width">
    <div class="apiarian-stats-bar__wrap">

      {% if section.settings.bee_image != blank %}
        <div class="apiarian-stats-bar__bee">
          {{
            section.settings.bee_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              decoding: 'async',
              widths: '300, 500, 700, 900',
              sizes: '(max-width: 749px) 180px, 260px',
              class: 'apiarian-stats-bar__bee-image',
              alt: section.settings.bee_image.alt
          }}
        </div>
      {% endif %}

      <div class="apiarian-stats-bar__grid">
        {% for block in section.blocks %}
          <div class="apiarian-stats-bar__item" {{ block.shopify_attributes }}>

            {% if block.settings.number != blank %}
              <div class="apiarian-stats-bar__number">
                {{ block.settings.number }}
              </div>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="apiarian-stats-bar__text">
                {{ block.settings.text }}
              </div>
            {% endif %}

          </div>
        {% endfor %}
      </div>

    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} .apiarian-stats-bar__wrap {
    position: relative;
    overflow: hidden;
    padding: 56px 62px;
    border-radius: {{ section.settings.border_radius }}px;
    background: {{ section.settings.bg_color }};
  }

  #{{ section_id }} .apiarian-stats-bar__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 48px;
    row-gap: 32px;
    align-items: start;
  }

  #{{ section_id }} .apiarian-stats-bar__item {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  #{{ section_id }} .apiarian-stats-bar__number {
    margin: 0 0 18px;
    color: {{ section.settings.number_color }};
    font-family: "Bodoni Moda", serif;
    font-size: {{ section.settings.number_size }}px;
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .apiarian-stats-bar__text {
    max-width: 280px;
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    line-height: 1.45;
  }

  #{{ section_id }} .apiarian-stats-bar__bee {
    position: absolute;
    top:0%;
    right: 126px;
    z-index: 1;
    width: {{ section.settings.bee_width }}px;
    transform:rotate(-24deg);
    opacity: {{ section.settings.bee_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  #{{ section_id }} .apiarian-stats-bar__bee-image {
    display: block;
    width: 100%;
    height: auto;
  }


  /* =========================
     PAGE ON SCROLL ANIMATION
  ========================= */

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
  .apiarian-stats-bar__wrap {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.55s ease,
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
  .apiarian-stats-bar__item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease,
      transform 0.68s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
  .apiarian-stats-bar__bee {
    opacity: 0;
    transform:rotate(-24deg);
    transition:
      opacity 0.6s ease 0.18s,
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.18s;
  }

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
  .apiarian-stats-bar__item:nth-child(1) {
    transition-delay: 0.10s;
  }

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
  .apiarian-stats-bar__item:nth-child(2) {
    transition-delay: 0.17s;
  }

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
  .apiarian-stats-bar__item:nth-child(3) {
    transition-delay: 0.24s;
  }

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
  .apiarian-stats-bar__item:nth-child(4) {
    transition-delay: 0.31s;
  }

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready.is-visible
  .apiarian-stats-bar__wrap,
  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready.is-visible
  .apiarian-stats-bar__item {
    opacity: 1;
    transform: translateY(0);
  }

  #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready.is-visible
  .apiarian-stats-bar__bee {
    opacity: {{ section.settings.bee_opacity | divided_by: 100.0 }};
    transform:rotate(-24deg);
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready.is-visible
    .apiarian-stats-bar__bee {
      opacity: {{ section.settings.mobile_bee_opacity | divided_by: 100.0 }};
    }
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .apiarian-stats-bar__wrap {
      padding: 42px 32px;
    }

    #{{ section_id }} .apiarian-stats-bar__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 28px;
      row-gap: 34px;
    }

    #{{ section_id }} .apiarian-stats-bar__number {
      margin-bottom: 14px;
      font-size: calc({{ section.settings.number_size }}px * 0.78);
    }

    #{{ section_id }} .apiarian-stats-bar__text {
      max-width: 100%;
      font-size: calc({{ section.settings.text_size }}px * 0.95);
    }

    #{{ section_id }} .apiarian-stats-bar__bee {
      right: 16px;
      width: calc({{ section.settings.bee_width }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .page-width {
      padding-left: 16px;
      padding-right: 16px;
    }

    #{{ section_id }} .apiarian-stats-bar__wrap {
      padding: 34px 22px 36px;
      border-radius: 24px;
    }

    #{{ section_id }} .apiarian-stats-bar__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 20px;
      row-gap: 32px;
      align-items: start;
    }

    #{{ section_id }} .apiarian-stats-bar__item {
      min-width: 0;
    }

    #{{ section_id }} .apiarian-stats-bar__number {
      margin-bottom: 10px;
      font-size: {{ section.settings.mobile_number_size }}px;
      line-height: 0.95;
      letter-spacing: -1px;
    }

    #{{ section_id }} .apiarian-stats-bar__text {
      max-width: 100%;
      padding: 0;
      font-size: {{ section.settings.mobile_text_size }}px;
      line-height: 1.45;
    }

    #{{ section_id }} .apiarian-stats-bar__bee {
      top: 50%;
      right: -25px;
      width: {{ section.settings.mobile_bee_width }}px;
      transform:rotate(-24deg);
      opacity: {{ section.settings.mobile_bee_opacity | divided_by: 100.0 }};
    }
  }

  @media screen and (max-width: 380px) {
    #{{ section_id }} .apiarian-stats-bar__wrap {
      padding-left: 18px;
      padding-right: 18px;
    }

    #{{ section_id }} .apiarian-stats-bar__grid {
      column-gap: 16px;
      row-gap: 28px;
    }

    #{{ section_id }} .apiarian-stats-bar__number {
      font-size: 42px;
    }

    #{{ section_id }} .apiarian-stats-bar__text {
      font-size: 14px;
    }

    #{{ section_id }} .apiarian-stats-bar__bee {
      right: -34px;
      width: 165px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
    .apiarian-stats-bar__wrap,
    #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
    .apiarian-stats-bar__item,
    #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
    .apiarian-stats-bar__bee {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #{{ section_id }}.apiarian-stats-bar-section.is-animation-ready
    .apiarian-stats-bar__bee {
      opacity: {{ section.settings.bee_opacity | divided_by: 100.0 }};
      transform:rotate(-24deg);
    }
  }

</style>


<script>
  (function () {
    function initApiarianStatsBar() {
      const section = document.getElementById('{{ section_id }}');

      if (!section || section.dataset.apiarianStatsInitialized === 'true') {
        return;
      }

      section.dataset.apiarianStatsInitialized = 'true';

      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        return;
      }

      const rect = section.getBoundingClientRect();
      const viewportHeight =
        window.innerHeight ||
        document.documentElement.clientHeight;

      /*
       * If already in/near the initial viewport, show immediately.
       * This keeps the section feeling fast on page load.
       */
      if (rect.top <= viewportHeight * 1.08) {
        return;
      }

      section.classList.add('is-animation-ready');

      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px 70px 0px'
        }
      );

      observer.observe(section);
    }

    initApiarianStatsBar();

    document.addEventListener('shopify:section:load', function (event) {
      if (
        event.target &&
        event.target.id === 'shopify-section-{{ section.id }}'
      ) {
        const section = document.getElementById('{{ section_id }}');

        if (section) {
          delete section.dataset.apiarianStatsInitialized;
          section.classList.remove('is-animation-ready', 'is-visible');
        }

        initApiarianStatsBar();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Apiarian Stats Bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
