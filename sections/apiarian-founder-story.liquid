{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_bg }};
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 78px;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__media {
    position: relative;
    min-height: 680px;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__main-image-wrap {
    position: relative;
    width: 100%;
    max-width: 566px;
    margin-left: auto;
    border-radius: 24px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__main-image {
    display: block;
    width: 100%;
    height: 680px;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__small-image-wrap {
    position: absolute;
    left: 0;
    bottom: 86px;
    width: 340px;
    border-radius: 24px;
    overflow: hidden;
    border: 4px solid #ffffff;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.08);
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__small-image {
    display: block;
    width: 100%;
    height: 460px;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__content {
    max-width: 760px;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__eyebrow {
    margin: 0 0 20px;
    color: {{ section.settings.eyebrow_color }};
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: 6px;
    text-transform: uppercase;
    font-weight:400;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__heading {
    margin: 0 0 21px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.22;
    font-weight:300;
    letter-spacing: 0;
    font-family: "Bodoni Moda", serif;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__heading em,
  #shopify-section-{{ section.id }} .apiarian-founder-story__heading i {
    font-style: italic;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__text {
    margin: 0 0 34px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    line-height: normal;
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__text p {
    margin: 0 0 18px;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__author {
    margin-top: 20px;
    margin-bottom: 36px;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__name {
    margin: 0px;
    color: {{ section.settings.heading_color }};
    font-size: 15px;
    line-height: 1.3;
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__role {
    margin: 0;
    color: {{ section.settings.text_color }};
     font-size:15px;
    line-height: 1.5;
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 172px;
    padding: 14px 30px;
    border: 1px solid {{ section.settings.button_border }};
    border-radius: 999px;
    background: transparent;
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size:15px;
    line-height: 1.2;
    font-weight: 300;
    transition: all 0.3s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story__button:hover {
    background: {{ section.settings.button_hover_bg }};
    color: {{ section.settings.button_hover_text }};
    border-color: {{ section.settings.button_hover_bg }};
  }

  /* animation */
  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__main-image-wrap,
  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__small-image-wrap,
  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__content {
    opacity: 0;
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__main-image-wrap {
    transform: translateX(50px);
    transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__small-image-wrap {
    transform: translateX(-50px);
    transition: opacity 0.75s ease 0.1s, transform 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.1s;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__content {
    transform: translateY(40px);
    transition: opacity 0.75s ease 0.15s, transform 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }

  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready.is-visible .apiarian-founder-story__main-image-wrap,
  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready.is-visible .apiarian-founder-story__small-image-wrap,
  #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready.is-visible .apiarian-founder-story__content {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .apiarian-founder-story__wrap {
      gap: 48px;
      grid-template-columns: 1fr 1fr;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__main-image {
      height: 600px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__small-image-wrap {
      width: 280px;
      bottom: 60px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__small-image {
      height: 380px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__heading {
      font-size: calc({{ section.settings.heading_size }}px * 0.88);
    }
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .apiarian-founder-story__wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__media {
      min-height: auto;
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding-bottom: 40px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__main-image-wrap {
      max-width: 100%;
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__main-image {
      height: 620px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__small-image-wrap {
      left: 0;
      bottom: 0;
      width: 280px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__small-image {
      height: 360px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .apiarian-founder-story {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__wrap {
      gap: 30px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__media {
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__main-image-wrap {
      max-width: 100%;
      border-radius: 18px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__main-image {
      height: 420px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__small-image-wrap {
      width: 150px;
      left: -6px;
      bottom: 34px;
      border-radius: 18px;
      border-width: 3px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__small-image {
      height: 230px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__eyebrow {
      margin-bottom: 16px;
      font-size: 12px;
      letter-spacing: 4px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__heading {
      margin-bottom: 24px;
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.22;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__text {
      margin-bottom: 24px;
      font-size: {{ section.settings.mobile_text_size }}px;
      line-height: 1.7;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__name {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__role {
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__author {
      margin-bottom: 24px;
    }

    #shopify-section-{{ section.id }} .apiarian-founder-story__button {
      min-width: 160px;
      padding: 12px 24px;
      font-size:14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__main-image-wrap,
    #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__small-image-wrap,
    #shopify-section-{{ section.id }} .apiarian-founder-story.is-animate-ready .apiarian-founder-story__content {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstyle %}

<section class="apiarian-founder-story" data-founder-story>
  <div class="page-width">
    <div class="apiarian-founder-story__wrap">
      <div class="apiarian-founder-story__media">
        {% if section.settings.main_image != blank %}
          <div class="apiarian-founder-story__main-image-wrap">
            {{
              section.settings.main_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(max-width: 749px) 100vw, (max-width: 989px) 90vw, 50vw',
                class: 'apiarian-founder-story__main-image',
                alt: section.settings.main_image.alt
            }}
          </div>
        {% endif %}

        {% if section.settings.small_image != blank %}
          <div class="apiarian-founder-story__small-image-wrap">
            {{
              section.settings.small_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '250, 350, 500, 700, 800',
                sizes: '(max-width: 749px) 150px, (max-width: 989px) 280px, 340px',
                class: 'apiarian-founder-story__small-image',
                alt: section.settings.small_image.alt
            }}
          </div>
        {% endif %}
      </div>

      <div class="apiarian-founder-story__content">
        {% if section.settings.eyebrow != blank %}
          <p class="apiarian-founder-story__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="apiarian-founder-story__heading">{{ section.settings.heading }}</div>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="apiarian-founder-story__text">{{ section.settings.text }}</div>
        {% endif %}

        <div class="apiarian-founder-story__author">
          {% if section.settings.author_name != blank %}
            <h3 class="apiarian-founder-story__name">{{ section.settings.author_name }}</h3>
          {% endif %}

          {% if section.settings.author_role != blank %}
            <p class="apiarian-founder-story__role">{{ section.settings.author_role }}</p>
          {% endif %}
        </div>

        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a href="{{ section.settings.button_link }}" class="apiarian-founder-story__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initFounderStorySection(sectionId) {
      var section = document.querySelector('#shopify-section-' + sectionId + ' .apiarian-founder-story');
      if (!section) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;

      var rect = section.getBoundingClientRect();
      var viewportHeight = window.innerHeight || document.documentElement.clientHeight;

      if (rect.top <= viewportHeight * 0.9) {
        section.classList.add('is-visible');
        return;
      }

      section.classList.add('is-animate-ready');

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.18,
        rootMargin: '0px 0px -40px 0px'
      });

      observer.observe(section);
    }

    document.addEventListener('DOMContentLoaded', function() {
      initFounderStorySection('{{ section.id }}');
    });

    document.addEventListener('shopify:section:load', function(event) {
      if (event.target && event.target.id === 'shopify-section-{{ section.id }}') {
        initFounderStorySection('{{ section.id }}');
      }
    });
  })();
</script>

{% schema %}
