    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#2A1F15"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F0E5D8"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Brand heading color",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
