    },

    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2026 The Apiarian Home"
    },

    {
      "type": "text",
      "id": "disclaimer",
      "label": "Right bottom text",
      "default": "Not a substitute for medical care"
