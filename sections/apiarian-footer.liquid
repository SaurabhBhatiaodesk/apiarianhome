{% style %}

  /* =========================
     SECTION
  ========================== */

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-footer {
    width: 100%;
    padding:
      {{ section.settings.padding_top }}px
      0
      {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-footer,
  #shopify-section-{{ section.id }} .apiarian-footer * {
    box-sizing: border-box;
    font-weight: 400;
  }


  /* =========================
     DESKTOP LAYOUT
  ========================== */

  #shopify-section-{{ section.id }} .apiarian-footer__top {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 0.9fr;
    gap: 70px;
    align-items: start;
  }


  /* =========================
     BRAND
  ========================== */

  #shopify-section-{{ section.id }} .apiarian-footer__logo-wrap {
    width: {{ section.settings.desktop_logo_width }}px;
    max-width: 100%;
    margin: 0 0 24px;
  }

  #shopify-section-{{ section.id }} .apiarian-footer__logo {
    display: block;
    width: 100%;
    height: auto;
    {% if section.settings.invert_logo %}
      filter: brightness(0) invert(1);
    {% else %}
      filter: none;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .apiarian-footer__brand-title {
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
    color: #fffcf6;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    font-family: "Bodoni Moda", serif;
  }

  #shopify-section-{{ section.id }} .apiarian-footer__brand-text {
    max-width: 370px;

    color: {{ section.settings.text_color }};

    font-size: 16px;
    font-weight:300;
    line-height: 1.75;
  }

  #shopify-section-{{ section.id }} .apiarian-footer__brand-text p {
    margin: 0;
    font-weight:300;
  }


  /* =========================
     MENU HEADINGS
  ========================== */

  #shopify-section-{{ section.id }} .apiarian-footer__column-title {
    margin: 0 0 13px;

    color: {{ section.settings.accent_color }};

    font-size: 12px;
    font-weight:300;
    line-height: 1.3;
    letter-spacing: 3px;
    text-transform: uppercase;
  }


  /* =========================
     LINKS
  ========================== */

  #shopify-section-{{ section.id }} .apiarian-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-footer__links li {
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-footer__links li:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-footer__links a {
    position: relative;

    display: inline-block;

    color: {{ section.settings.text_color }};
    text-decoration: none;

    font-size: 15px;
    font-weight:300;
    line-height: 1.5;

    transition: color 0.35s ease;
  }


  /* =========================
     SMOOTH UNDERLINE
  ========================== */

  #shopify-section-{{ section.id }} .apiarian-footer__links a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: 0;

    width: 100%;
    height: 1px;

    background-color: currentColor;

    transform: scaleX(0);
    transform-origin: right center;

    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-footer__links a:hover {
    color: {{ section.settings.link_hover_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-footer__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left center;
  }


  /* Keyboard focus */

  #shopify-section-{{ section.id }} .apiarian-footer__links a:focus-visible {
    color: {{ section.settings.link_hover_color }};
    outline: none;
  }

  #shopify-section-{{ section.id }} .apiarian-footer__links a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }


  /* =========================
     BOTTOM
  ========================== */

  #shopify-section-{{ section.id }} .apiarian-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;

    margin-top: 65px;
    padding-top: 26px;

    border-top: 1px solid {{ section.settings.border_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-footer__copyright,
  #shopify-section-{{ section.id }} .apiarian-footer__disclaimer {
    margin: 0;

    color: {{ section.settings.muted_color }};

    font-size: 13px;
    font-weight:300;
    line-height: 1.4;
    letter-spacing: 2px;
  }


  /* =========================
     MOBILE MENU HIDDEN
  ========================== */

  #shopify-section-{{ section.id }} .apiarian-footer__mobile-menu {
    display: none;
  }


  /* =========================
     TABLET
  ========================== */

  @media screen and (max-width: 990px) {

    #shopify-section-{{ section.id }} .apiarian-footer {
      padding-left: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__top {
      grid-template-columns: 1.25fr 1fr 1fr 1fr;
      gap: 35px;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__brand-title {
      font-size: 19px;
      letter-spacing: 5px;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__brand-text,
    #shopify-section-{{ section.id }} .apiarian-footer__links a {
      font-size: 16px;
    }

  }


  /* =========================
     MOBILE
  ========================== */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .apiarian-footer {
      padding:
        {{ section.settings.mobile_padding_top }}px
        0
        {{ section.settings.mobile_padding_bottom }}px;
    }


    /* Brand */

    #shopify-section-{{ section.id }} .apiarian-footer__top {
      display: block;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__brand {
      margin-bottom: 38px;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__logo-wrap {
      width: {{ section.settings.mobile_logo_width }}px;
      margin-bottom: 18px;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__brand-title {
      margin: 0 0 18px;

      font-size: 18px;
      font-weight: 400;
      line-height: 1.3;
      letter-spacing: 4px;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__brand-text {
      max-width: 100%;

      font-size: 15px;
      font-weight:300;
      line-height: 1.7;
    }


    /* Hide desktop menu */

    #shopify-section-{{ section.id }} .apiarian-footer__desktop-menu {
      display: none;
    }


    /* =========================
       MOBILE ACCORDION
    ========================== */

    #shopify-section-{{ section.id }} .apiarian-footer__mobile-menu {
      display: block;

      border-top: 1px solid {{ section.settings.border_color }};
    }

    #shopify-section-{{ section.id }} .apiarian-footer__accordion {
      margin: 0;
      padding: 0;

      border-bottom: 1px solid {{ section.settings.border_color }};
    }

    #shopify-section-{{ section.id }} .apiarian-footer__accordion summary {
      display: flex;
      align-items: center;
      justify-content: space-between;

      width: 100%;
      gap: 15px;

      margin: 0;
      padding: 22px 0;

      list-style: none;
      cursor: pointer;

      color: {{ section.settings.accent_color }};

      font-size: 13px;
      font-weight: 400;
      line-height: 1.3;
      letter-spacing: 2.5px;
      text-transform: uppercase;

      user-select: none;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion
      summary::-webkit-details-marker {
      display: none;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion
      summary::marker {
      content: "";
    }


    /* =========================
       PLUS / MINUS
    ========================== */

    #shopify-section-{{ section.id }} .apiarian-footer__accordion-icon {
      position: relative;

      display: block;

      width: 16px;
      height: 16px;

      flex: 0 0 16px;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-icon::before,
    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-icon::after {
      content: "";

      position: absolute;
      top: 50%;
      left: 50%;

      background-color: {{ section.settings.accent_color }};

      transform: translate(-50%, -50%);

      transition:
        transform 0.3s ease,
        opacity 0.3s ease;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-icon::before {
      width: 16px;
      height: 1px;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-icon::after {
      width: 1px;
      height: 16px;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion[open]
      .apiarian-footer__accordion-icon::after {
      opacity: 0;

      transform:
        translate(-50%, -50%)
        rotate(90deg);
    }


    /* =========================
       ACCORDION CONTENT
    ========================== */

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-content {
      padding: 0 0 22px;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-content
      .apiarian-footer__links {
      margin: 0;
      padding: 0;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-content
      .apiarian-footer__links li {
      margin: 0 0 18px;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-content
      .apiarian-footer__links li:last-child {
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }}
      .apiarian-footer__accordion-content
      .apiarian-footer__links a {
      font-size: 15px;
      font-weight:300;
    }


    /* =========================
       MOBILE BOTTOM
    ========================== */

    #shopify-section-{{ section.id }} .apiarian-footer__bottom {
      display: block;
        border-top:0;
      margin-top: 35px;
      padding-top: 0;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__copyright,
    #shopify-section-{{ section.id }} .apiarian-footer__disclaimer {
      font-size: 12px;
      font-weight: 400;
      line-height: 1.5;
      letter-spacing: 1.5px;
    }

    #shopify-section-{{ section.id }} .apiarian-footer__disclaimer {
      margin-top: 15px;
    }

  }

{% endstyle %}


<section class="apiarian-footer">
  <div class="page-width">


  <!-- =========================
       TOP
  ========================== -->

  <div class="apiarian-footer__top">


    <!-- BRAND -->

    <div class="apiarian-footer__brand">

      {% if section.settings.logo != blank %}

        <div class="apiarian-footer__logo-wrap">
          {{
            section.settings.logo
            | image_url: width: 700
            | image_tag:
              loading: 'lazy',
              decoding: 'async',
              widths: '120, 180, 240, 320, 480, 700',
              sizes: '(max-width: 749px) 240px, 320px',
              class: 'apiarian-footer__logo',
              alt: section.settings.logo.alt
          }}
        </div>

      {% elsif section.settings.brand_title != blank %}

        <h2 class="apiarian-footer__brand-title">
          {{ section.settings.brand_title | escape }}
        </h2>

      {% endif %}


      {% if section.settings.brand_text != blank %}

        <div class="apiarian-footer__brand-text">
          {{ section.settings.brand_text }}
        </div>

      {% endif %}

    </div>


    <!-- =========================
         DESKTOP MENU
    ========================== -->

    {% for block in section.blocks %}

      <div
        class="apiarian-footer__desktop-menu"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.heading != blank %}

          <h3 class="apiarian-footer__column-title">
            {{ block.settings.heading | escape }}
          </h3>

        {% endif %}


        {% if block.settings.menu != blank %}

          <ul class="apiarian-footer__links">

            {% for link in block.settings.menu.links %}

              <li>

                <a href="{{ link.url }}">
                  {{ link.title | escape }}
                </a>

              </li>

            {% endfor %}

          </ul>

        {% endif %}

      </div>

    {% endfor %}


  </div>


  <!-- =========================
       MOBILE ACCORDIONS
  ========================== -->

  <div class="apiarian-footer__mobile-menu">

    {% for block in section.blocks %}

      <details
        class="apiarian-footer__accordion"
        {{ block.shopify_attributes }}
      >

        <summary>

          <span class="apiarian-footer__accordion-title">
            {{ block.settings.heading | escape }}
          </span>

          <span
            class="apiarian-footer__accordion-icon"
            aria-hidden="true"
          ></span>

        </summary>


        <div class="apiarian-footer__accordion-content">

          {% if block.settings.menu != blank %}

            <ul class="apiarian-footer__links">

              {% for link in block.settings.menu.links %}

                <li>

                  <a href="{{ link.url }}">
                    {{ link.title | escape }}
                  </a>

                </li>

              {% endfor %}

            </ul>

          {% endif %}

        </div>

      </details>

    {% endfor %}

  </div>


  <!-- =========================
       BOTTOM
  ========================== -->

  <div class="apiarian-footer__bottom">

    {% if section.settings.copyright_text != blank %}

      <p class="apiarian-footer__copyright">
        {{ section.settings.copyright_text | escape }}
      </p>

    {% endif %}


    {% if section.settings.disclaimer != blank %}

      <p class="apiarian-footer__disclaimer">
        {{ section.settings.disclaimer | escape }}
      </p>

    {% endif %}

  </div>

  </div>
</section>


<!-- =========================
     MOBILE ACCORDION SCRIPT
========================== -->

<script>
  (function () {

    function initApiarianFooterAccordion() {

      const section = document.querySelector(
        '#shopify-section-{{ section.id }}'
      );

      if (!section) return;


      const accordions = section.querySelectorAll(
        '.apiarian-footer__accordion'
      );

      if (!accordions.length) return;


      accordions.forEach(function (accordion) {

        if (accordion.dataset.apiarianInitialized === 'true') {
          return;
        }

        accordion.dataset.apiarianInitialized = 'true';


        accordion.addEventListener('toggle', function () {

          if (!accordion.open) return;


          accordions.forEach(function (otherAccordion) {

            if (
              otherAccordion !== accordion &&
              otherAccordion.open
            ) {
              otherAccordion.removeAttribute('open');
            }

          });

        });

      });

    }


    if (document.readyState === 'loading') {

      document.addEventListener(
        'DOMContentLoaded',
        initApiarianFooterAccordion
      );

    } else {

      initApiarianFooterAccordion();

    }


    document.addEventListener(
      'shopify:section:load',
      function (event) {

        if (
          event.target &&
          event.target.id ===
            'shopify-section-{{ section.id }}'
        ) {
          initApiarianFooterAccordion();
        }

      }
    );

  })();
</script>


{% schema %}
{
  "name": "Apiarian Footer",
  "tag": "section",
  "class": "section-apiarian-footer",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
