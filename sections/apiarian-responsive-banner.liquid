{% style %}
#shopify-section-{{ section.id }} .apiarian-responsive-banner {
  width: 100%;
  overflow: hidden;
}

#shopify-section-{{ section.id }} .apiarian-responsive-banner__picture,
#shopify-section-{{ section.id }} .apiarian-responsive-banner__image {
  display: block;
  width: 100%;
}

#shopify-section-{{ section.id }} .apiarian-responsive-banner__image {
  height: auto;
}
{% endstyle %}

<section class="apiarian-responsive-banner">
  {% if section.settings.desktop_image != blank %}
    <picture class="apiarian-responsive-banner__picture">

      {% if section.settings.mobile_image != blank %}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
            {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
            {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w
          "
          sizes="100vw"
        >
      {% endif %}

      <source
        media="(min-width: 750px)"
        srcset="
          {{ section.settings.desktop_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.desktop_image | image_url: width: 1600 }} 1600w,
          {{ section.settings.desktop_image | image_url: width: 2000 }} 2000w,
          {{ section.settings.desktop_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
      >

      {{
        section.settings.desktop_image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          decoding: 'async',
          widths: '750, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          class: 'apiarian-responsive-banner__image',
          alt: section.settings.desktop_image.alt
      }}

    </picture>
  {% endif %}
</section>

{% schema %}
{
  "name": "Responsive Image Banner",
  "tag": "section",
  "class": "section-responsive-image-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    }
  ],
  "presets": [
    {
      "name": "Responsive Image Banner"
    }
  ]
}
{% endschema %}
