{% comment %}
  Section: Apiarian Ingredients & Sourcing
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .apiarian-ingredients,
  #shopify-section-{{ section.id }} .apiarian-ingredients * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients {
    margin-top: {{ section.settings.spacing_top }}px;
    margin-bottom: {{ section.settings.spacing_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__inner {
    display: grid;
    grid-template-columns:
      minmax(0, {{ section.settings.left_width }}fr)
      minmax(0, {{ 100 | minus: section.settings.left_width }}fr);
    gap: {{ section.settings.column_gap }}px; 
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__content {
    max-width: 720px;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_bottom_spacing }}px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__heading {
    margin: 0 0 {{ section.settings.heading_bottom_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.7px;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__heading em {
    font-family: "Bodoni Moda", serif;
    font-style: italic;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__text {
    max-width: 610px;
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    font-weight: 300;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__card {
    padding: {{ section.settings.card_padding }}px;
    border-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.card_background }};
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__card-title {
    margin: 0 0 {{ section.settings.card_title_bottom_spacing }}px;
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 400;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__card-text {
    margin: 0;
    color: {{ section.settings.card_text_color }};
    font-size: {{ section.settings.card_text_size }}px;
    font-weight: 300;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients__card-text p {
    margin: 0;
  }

  /* lightweight page-on-scroll animation */
  #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready
  .apiarian-ingredients__content {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity .45s ease,
      transform .6s cubic-bezier(.22, 1, .36, 1);
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready
  .apiarian-ingredients__card {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity .45s ease,
      transform .6s cubic-bezier(.22, 1, .36, 1);
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready
  .apiarian-ingredients__card:nth-child(2) {
    transition-delay: .05s;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready
  .apiarian-ingredients__card:nth-child(3) {
    transition-delay: .1s;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready
  .apiarian-ingredients__card:nth-child(4) {
    transition-delay: .15s;
  }

  #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready.is-visible
  .apiarian-ingredients__content,
  #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready.is-visible
  .apiarian-ingredients__card {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .apiarian-ingredients__inner {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__content {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__eyebrow {
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
      letter-spacing: {{ section.settings.mobile_eyebrow_letter_spacing }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__text {
      max-width: 100%;
      font-size: {{ section.settings.mobile_text_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__card-title {
      font-size: {{ section.settings.mobile_card_title_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__card-text {
      font-size: {{ section.settings.mobile_card_text_size }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .apiarian-ingredients {
      margin-top: {{ section.settings.mobile_spacing_top }}px;
      margin-bottom: {{ section.settings.mobile_spacing_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__inner {
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__cards {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_card_gap }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-ingredients__card {
      min-height: 0;
      padding: {{ section.settings.mobile_card_padding }}px;
      border-radius: {{ section.settings.mobile_card_radius }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready
    .apiarian-ingredients__content,
    #shopify-section-{{ section.id }} .apiarian-ingredients.is-animation-ready
    .apiarian-ingredients__card {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<section
  class="apiarian-ingredients page-width"
  data-apiarian-ingredients
>
  <div class="apiarian-ingredients__inner">

    <div class="apiarian-ingredients__content">

      {% if section.settings.eyebrow != blank %}
        <p class="apiarian-ingredients__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="apiarian-ingredients__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="apiarian-ingredients__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

    </div>

    {% if section.blocks.size > 0 %}
      <div class="apiarian-ingredients__cards">
        {% for block in section.blocks %}
          <article
            class="apiarian-ingredients__card"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.title != blank %}
              <h3 class="apiarian-ingredients__card-title">
                {{ block.settings.title | escape }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="apiarian-ingredients__card-text">
                {{ block.settings.text }}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<script>
  (function () {
    const section = document.querySelector(
      '#shopify-section-{{ section.id }} [data-apiarian-ingredients]'
    );

    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    ) {
      return;
    }

    const rect = section.getBoundingClientRect();
    const viewportHeight =
      window.innerHeight || document.documentElement.clientHeight;

    if (rect.top <= viewportHeight * 0.94) return;

    section.classList.add('is-animation-ready');

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;

          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -4% 0px'
      }
    );

    observer.observe(section);
  })();
</script>

