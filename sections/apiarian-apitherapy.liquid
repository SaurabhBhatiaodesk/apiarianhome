}

@media screen and (max-width: 420px) {
  #shopify-section-{{ section.id }} .apiarian-apitherapy__resource {
    grid-template-columns: 1fr;
    gap: 7px;
  }

  #shopify-section-{{ section.id }} .apiarian-apitherapy__resource-link {
    justify-self: start;
  }
}

@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }}
  .apiarian-apitherapy.is-animation-ready
  .apiarian-apitherapy__media,
  #shopify-section-{{ section.id }}
  .apiarian-apitherapy.is-animation-ready
  .apiarian-apitherapy__eyebrow,
  #shopify-section-{{ section.id }}
  .apiarian-apitherapy.is-animation-ready
  .apiarian-apitherapy__heading,
  #shopify-section-{{ section.id }}
  .apiarian-apitherapy.is-animation-ready
  .apiarian-apitherapy__text,
  #shopify-section-{{ section.id }}
  .apiarian-apitherapy.is-animation-ready
  .apiarian-apitherapy__resource,
  #shopify-section-{{ section.id }}
  .apiarian-apitherapy.is-animation-ready
  .apiarian-apitherapy__button {
    opacity: 1;
    transform: none;
    transition: none;
    will-change: auto;
  }
}
{% endstyle %}


<section
  class="apiarian-apitherapy"
  data-apiarian-apitherapy
>
  <div class="page-width">
    <div class="apiarian-apitherapy__card">

      <div class="apiarian-apitherapy__media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              decoding: 'async',
              widths: '500, 750, 1000, 1300, 1600, 1800',
              sizes: '(max-width: 749px) 100vw, 50vw',
              class: 'apiarian-apitherapy__image',
              alt: section.settings.image.alt
          }}
        {% endif %}
      </div>

      <div class="apiarian-apitherapy__panel">

        {% if section.settings.panel_art != blank %}
          <div class="apiarian-apitherapy__panel-art">
            {{
              section.settings.panel_art
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                decoding: 'async',
                widths: '300, 450, 600, 750, 900',
                alt: section.settings.panel_art.alt
            }}
          </div>
        {% endif %}

        <div class="apiarian-apitherapy__content">

          {% if section.settings.eyebrow != blank %}
            <p class="apiarian-apitherapy__eyebrow">
              {{ section.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <div class="apiarian-apitherapy__heading">
              {{ section.settings.heading }}
            </div>
          {% endif %}

          {% if section.settings.text != blank %}
            <div class="apiarian-apitherapy__text">
              {{ section.settings.text }}
            </div>
          {% endif %}

          {% if section.blocks.size > 0 %}
            <div class="apiarian-apitherapy__resources">
              {% for block in section.blocks %}
                <div
                  class="apiarian-apitherapy__resource"
                  {{ block.shopify_attributes }}
                >
                  <div class="apiarian-apitherapy__resource-title">
                    {{ block.settings.title | escape }}
                  </div>

                  {% if block.settings.link_label != blank %}
                    {% if block.settings.link != blank %}
                      <a
                        href="{{ block.settings.link }}"
                        class="apiarian-apitherapy__resource-link"
                      >
                        {{ block.settings.link_label | escape }}
                      </a>
                    {% else %}
                      <span class="apiarian-apitherapy__resource-link">
                        {{ block.settings.link_label | escape }}
                      </span>
                    {% endif %}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.button_label != blank and section.settings.button_link != blank %}
            <a
              href="{{ section.settings.button_link }}"
              class="apiarian-apitherapy__button"
            >
              {{ section.settings.button_label | escape }}
            </a>
          {% endif %}

        </div>
      </div>

    </div>
  </div>
</section>


<script>
  (function () {
    function initApiarianApitherapy() {
      const section = document.querySelector(
        '#shopify-section-{{ section.id }} [data-apiarian-apitherapy]'
      );

      if (!section || section.dataset.apiarianApitherapyInitialized === 'true') {
        return;
      }

      section.dataset.apiarianApitherapyInitialized = 'true';

      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        return;
      }

      const rect = section.getBoundingClientRect();
      const viewportHeight =
        window.innerHeight ||
        document.documentElement.clientHeight;

      if (rect.top <= viewportHeight * 1.05) {
        return;
      }

      section.classList.add('is-animation-ready');

      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px 80px 0px'
        }
      );

      observer.observe(section);
    }

    initApiarianApitherapy();

    document.addEventListener('shopify:section:load', function (event) {
      if (
        event.target &&
        event.target.id === 'shopify-section-{{ section.id }}'
      ) {
        const section = event.target.querySelector(
          '[data-apiarian-apitherapy]'
        );

        if (section) {
          delete section.dataset.apiarianApitherapyInitialized;
          section.classList.remove('is-animation-ready', 'is-visible');
        }

        initApiarianApitherapy();
      }
    });
  })();
</script>


