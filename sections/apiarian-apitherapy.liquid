    top: -14px;
    right: -24px;
    width: 230px;
    max-width: 68%;
  }

  #shopify-section-{{ section.id }} .apiarian-apitherapy__eyebrow {
    margin-bottom: 18px;
    font-size: 11px;
    letter-spacing: 4px;
  }

  #shopify-section-{{ section.id }} .apiarian-apitherapy__heading {
    margin-bottom: 20px;
    font-size: {{ section.settings.mobile_heading_size }}px;
    line-height: 1.08;
