{% style %}
#shopify-section-{{ section.id }} {
  background: {{ section.settings.section_background }};
}

#shopify-section-{{ section.id }} .apiarian-apitherapy,
#shopify-section-{{ section.id }} .apiarian-apitherapy * {
  box-sizing: border-box;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy {
  width: 100%;
  padding:
    {{ section.settings.padding_top }}px
    0
    {{ section.settings.padding_bottom }}px;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  overflow: hidden;
  border-radius: {{ section.settings.card_radius }}px;
  background: {{ section.settings.panel_background }};
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__media {
  position: relative;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  background: #d9d1c4;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  object-fit: cover;
  object-position: {{ section.settings.desktop_image_position }};
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__panel {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 58px 64px 58px;
  background: {{ section.settings.panel_background }};
  color: {{ section.settings.text_color }};
  overflow: hidden;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__panel-art {
  position: absolute;
  top: -34px;
  right: -22px;
  z-index: 0;
  width: {{ section.settings.art_width }}px;
  max-width: 68%;
  opacity: {{ section.settings.art_opacity | divided_by: 100.0 }};
  pointer-events: none;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__panel-art img {
  display: block;
  width: 100%;
  height: auto;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__content {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 760px;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__eyebrow {
  margin: 0 0 26px;
  color: {{ section.settings.accent_color }};
  font-size: 14px;
  font-weight:300;
  line-height: 1.2;
  letter-spacing: 5px;
  text-transform: uppercase;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__heading {
  max-width: 760px;
  margin: 0 0 28px;
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight:300;
  line-height: 1.08;
  letter-spacing: -1.2px;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__heading em,
#shopify-section-{{ section.id }} .apiarian-apitherapy__heading i {
  font-family: "Bodoni Moda", serif;
  font-style: italic;
  font-weight: 400;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__text {
  max-width: 690px;
  margin: 0 0 26px;
  color: {{ section.settings.body_color }};
  font-size: {{ section.settings.body_size }}px;
  font-weight: 300;
  line-height: 1.7;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__text p {
  margin: 0 0 14px;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__text p:last-child {
  margin-bottom: 0;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__resources {
  margin-top: 22px;
  border-top: 1px solid {{ section.settings.divider_color }};
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__resource {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 24px;
  min-height: 66px;
  padding: 16px 0;
  border-bottom: 1px solid {{ section.settings.divider_color }};
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__resource-title {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight:300;
  line-height: 1.35;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__resource-link {
  color: {{ section.settings.accent_color }};
  font-size: 13px;
  font-weight:300;
  line-height: 1.2;
  letter-spacing: 2px;
  text-decoration: none;
  text-transform: uppercase;
  white-space: nowrap;
  transition: opacity 0.25s ease;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__resource-link:hover {
  opacity: 0.72;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56px;
  margin-top: 24px;
  padding: 14px 32px;
  border: 1px solid {{ section.settings.button_background }};
  border-radius: 999px;
  background: {{ section.settings.button_background }};
  color: {{ section.settings.button_text }};
  font-size: 15px;
  font-weight:300;
  line-height: 1.2;
  text-decoration: none;
  transition:
    background-color 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

#shopify-section-{{ section.id }} .apiarian-apitherapy__button:hover {
  background: {{ section.settings.button_hover_background }};
  border-color: {{ section.settings.button_hover_background }};
  color: {{ section.settings.button_hover_text }};
  transform: translateY(-1px);
}


/* =========================
   PAGE ON SCROLL ANIMATION
========================= */

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__media,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__eyebrow,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__heading,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__text,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__resource,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__button {
  opacity: 0;
  will-change: opacity, transform;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__media {
  transform: translateX(-28px);
  transition:
    opacity 0.65s ease 0s,
    transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0s;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__eyebrow,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__heading,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__text,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__resource,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__button {
  transform: translateY(20px);
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__eyebrow {
  transition:
    opacity 0.5s ease 0.08s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.08s;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__heading {
  transition:
    opacity 0.55s ease 0.14s,
    transform 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.14s;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__text {
  transition:
    opacity 0.5s ease 0.20s,
    transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.20s;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__resource:nth-child(1) {
  transition:
    opacity 0.5s ease 0.24s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.24s;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__resource:nth-child(2) {
  transition:
    opacity 0.5s ease 0.30s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.30s;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__resource:nth-child(3) {
  transition:
    opacity 0.5s ease 0.36s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.36s;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__resource:nth-child(4) {
  transition:
    opacity 0.5s ease 0.42s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.42s;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready
.apiarian-apitherapy__button {
  transition:
    opacity 0.5s ease 0.46s,
    transform 0.68s cubic-bezier(0.22, 1, 0.36, 1) 0.46s,
    background-color 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease;
}

#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready.is-visible
.apiarian-apitherapy__media,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready.is-visible
.apiarian-apitherapy__eyebrow,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready.is-visible
.apiarian-apitherapy__heading,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready.is-visible
.apiarian-apitherapy__text,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready.is-visible
.apiarian-apitherapy__resource,
#shopify-section-{{ section.id }}
.apiarian-apitherapy.is-animation-ready.is-visible
.apiarian-apitherapy__button {
  opacity: 1;
  transform: translate(0, 0);
}


/* =========================
   TABLET
========================= */

@media screen and (max-width: 1100px) {
  #shopify-section-{{ section.id }} .apiarian-apitherapy__card {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .apiarian-apitherapy__panel {
    padding: 48px 42px;
  }

  #shopify-section-{{ section.id }} .apiarian-apitherapy__heading {
    font-size: calc({{ section.settings.heading_size }}px * 0.84);
  }

  #shopify-section-{{ section.id }} .apiarian-apitherapy__text {
    font-size: calc({{ section.settings.body_size }}px * 0.94);
  }
}


/* =========================
   MOBILE
========================= */

