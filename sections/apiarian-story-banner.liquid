{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner,
  #shopify-section-{{ section.id }} .apiarian-story-banner * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
    padding: 64px 60px;
    border-radius: {{ section.settings.radius }}px;
    background: {{ section.settings.panel_background }};
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner__eyebrow {
    margin: 0 0 20px;
    color: {{ section.settings.accent_color }};
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner__heading {
    max-width: 18ch;
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.014em;
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner__heading em,
  #shopify-section-{{ section.id }} .apiarian-story-banner__heading i {
    font-family: "Bodoni Moda", serif;
    font-style: italic;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner__text {
    max-width: 46ch;
    margin: 0 0 28px;
    color: {{ section.settings.text_color }};
    font-size: 18px;
    font-weight: 300;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 26px;
    border: 0;
    border-radius: 999px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    font-size: 15px;
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-story-banner__button:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .apiarian-story-banner__panel {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 48px 40px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .apiarian-story-banner {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-story-banner__panel {
      padding: 36px 24px;
      border-radius: 22px;
    }

    #shopify-section-{{ section.id }} .apiarian-story-banner__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-story-banner__text {
      font-size: 16px;
    }
  }
{% endstyle %}

<section class="apiarian-story-banner">
  <div class="page-width">
    <div class="apiarian-story-banner__panel">
      <div>
        {% if section.settings.eyebrow != blank %}
          <div class="apiarian-story-banner__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="apiarian-story-banner__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      <div>
        {% if section.settings.text != blank %}
          <div class="apiarian-story-banner__text">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="apiarian-story-banner__button">
            {{ section.settings.button_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story banner",
  "tag": "section",
  "class": "section-apiarian-story-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "One beekeeper"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Blended by hand in Fort Collins, <em>from her own hives.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Netta keeps the colonies, renders the wax and blends every batch small enough to carry its own character. Nothing in the collection uses synthetic fragrance, and a portion of every sale funds pollinators.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read her story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFCF6"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#2A2118"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow color",
      "default": "#C79A3C"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFCF6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#D9CDBA"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#F0D89B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#2A2118"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#FFFCF6"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#2A2118"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 24,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Panel radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Story banner"
    }
  ]
}
{% endschema %}
