{% comment %}
  Section: Apiarian Discovery Set
  Two-column promotional section matching the supplied reference.
{% endcomment %}

{%- assign set_products = section.settings.set_products -%}
{%- assign set_total_price = 0 -%}
{%- assign set_available = true -%}
{%- assign set_product_count = 0 -%}

{%- for set_product in set_products -%}
  {%- assign set_variant = set_product.selected_or_first_available_variant -%}

  {%- if set_variant != blank -%}
    {%- assign set_total_price = set_total_price | plus: set_variant.price -%}
    {%- assign set_product_count = set_product_count | plus: 1 -%}

    {%- unless set_variant.available -%}
      {%- assign set_available = false -%}
    {%- endunless -%}
  {%- else -%}
    {%- assign set_available = false -%}
  {%- endif -%}
{%- endfor -%}

{%- if set_product_count == 0 -%}
  {%- assign set_available = false -%}
{%- endif -%}

{%- assign clean_button_label = section.settings.button_label | split: '—' | first | strip -%}

<style>
  #shopify-section-{{ section.id }} .apiarian-discovery-set,
  #shopify-section-{{ section.id }} .apiarian-discovery-set * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set {
    margin-top: {{ section.settings.spacing_top }}px;
    margin-bottom: {{ section.settings.spacing_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__inner {
    display: grid;
    grid-template-columns: minmax(0, {{ section.settings.left_width }}fr) minmax(0, {{ 100 | minus: section.settings.left_width }}fr);
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    background: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__content {
    display: flex;
    align-items: center;
    padding:
      {{ section.settings.content_padding_vertical }}px
      {{ section.settings.content_padding_horizontal }}px;
    background: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__content-inner {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__eyebrow {
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__heading {
    margin: 0 0 {{ section.settings.heading_bottom_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight:300;
    line-height: 1.08;
    letter-spacing: -0.8px;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__heading em {
    font-style: italic;
    font-weight: 400;
    font-family: "Bodoni Moda", serif;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__text {
    margin: 0 0 {{ section.settings.text_bottom_spacing }}px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    font-weight:300;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: {{ section.settings.action_gap }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__button {
    -webkit-appearance: none;
    appearance: none;
    position: relative;
    z-index: 1;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding:13px 24px;

    margin: 0;
    border: 0;
    outline: 0;
    border-radius: 999px;

    background: {{ section.settings.button_background }};
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};

    box-shadow: none;
    font-family: inherit;
    font-size: {{ section.settings.button_text_size }}px;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;

    cursor: pointer;
    pointer-events: auto;

    transition:
      opacity .25s ease,
      transform .25s ease,
      box-shadow .25s ease;
  }
  #shopify-section-{{ section.id }} .apiarian-discovery-set__button:hover:not([disabled]) {
    opacity: .9;
    background: #2a2118;
    background-color: #2a2118;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__button:focus-visible {
    outline: 2px solid {{ section.settings.button_text_color }};
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__button[disabled] {
    opacity: .55;
    cursor: not-allowed;
    pointer-events: none;
    transform: none;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__button.is-loading {
    cursor: wait;
    pointer-events: none;
    opacity: .7;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__cart-error {
    display: none;
    width: 100%;
    margin: 8px 0 0;
    color: {{ section.settings.button_text_color }};
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__cart-error.is-visible {
    display: block;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__note {
    margin: 0;
    color: {{ section.settings.note_color }};
    font-size: {{ section.settings.note_size }}px;
    font-weight: 400;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__media {
    position: relative;
    min-width: 0;
    background: {{ section.settings.image_background }};
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__image,
  #shopify-section-{{ section.id }} .apiarian-discovery-set__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set__placeholder {
    background: {{ section.settings.image_background }};
  }

  /* Lightweight page-on-scroll animation */
  #shopify-section-{{ section.id }} .apiarian-discovery-set.is-animation-ready
  .apiarian-discovery-set__content-inner {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .5s ease, transform .65s cubic-bezier(.22,1,.36,1);
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set.is-animation-ready
  .apiarian-discovery-set__media {
    opacity: 0;
    transform: translateX(18px);
    transition: opacity .55s ease .08s, transform .7s cubic-bezier(.22,1,.36,1) .08s;
  }

  #shopify-section-{{ section.id }} .apiarian-discovery-set.is-animation-ready.is-visible
  .apiarian-discovery-set__content-inner,
  #shopify-section-{{ section.id }} .apiarian-discovery-set.is-animation-ready.is-visible
  .apiarian-discovery-set__media {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .apiarian-discovery-set {
      margin-top: {{ section.settings.mobile_spacing_top }}px;
      margin-bottom: {{ section.settings.mobile_spacing_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__inner {
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: {{ section.settings.mobile_border_radius }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__content {
      order: 2;
      padding:
        {{ section.settings.mobile_content_padding_vertical }}px
        {{ section.settings.mobile_content_padding_horizontal }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__media {
      order: 1;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__content-inner {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__eyebrow {
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
      letter-spacing: {{ section.settings.mobile_eyebrow_letter_spacing }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__heading {
      margin-bottom: {{ section.settings.mobile_heading_bottom_spacing }}px;
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__text {
      max-width: 100%;
      margin-bottom: {{ section.settings.mobile_text_bottom_spacing }}px;
      font-size: {{ section.settings.mobile_text_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__actions {
      gap: {{ section.settings.mobile_action_gap }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__button {
      font-size: {{ section.settings.mobile_button_text_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__note {
      font-size: {{ section.settings.mobile_note_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__media {
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__image {
      height: auto;
    }

    #shopify-section-{{ section.id }} .apiarian-discovery-set__placeholder {
      min-height: 260px;
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .apiarian-discovery-set.is-animation-ready
    .apiarian-discovery-set__content-inner,
    #shopify-section-{{ section.id }} .apiarian-discovery-set.is-animation-ready
    .apiarian-discovery-set__media {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<section
  class="apiarian-discovery-set page-width"
  data-apiarian-discovery-set
>
  <div class="apiarian-discovery-set__inner">

    <div class="apiarian-discovery-set__content">
      <div class="apiarian-discovery-set__content-inner">

        {% if section.settings.eyebrow != blank %}
          <p class="apiarian-discovery-set__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="apiarian-discovery-set__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="apiarian-discovery-set__text">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank or section.settings.note != blank %}
          <div class="apiarian-discovery-set__actions">

            {% if section.settings.button_label != blank %}
              <button
                type="button"
                class="apiarian-discovery-set__button"
                data-discovery-add
                {% unless set_available %}
                  disabled
                {% endunless %}
              >
                <span data-discovery-button-text>
                  {{ clean_button_label | escape }}
                  {% if set_product_count > 0 %}
                    — {{ set_total_price | money }}
                  {% endif %}
                </span>
              </button>
            {% endif %}

            {% if section.settings.note != blank %}
              <p class="apiarian-discovery-set__note">
                {{ section.settings.note | escape }}
              </p>
            {% endif %}

            <p
              class="apiarian-discovery-set__cart-error"
              data-discovery-cart-error
              role="alert"
            ></p>

          </div>
        {% endif %}

      </div>
    </div>

    <script type="application/json" data-discovery-items>
      [
        {%- assign item_index = 0 -%}
        {%- for set_product in set_products -%}
          {%- assign set_variant = set_product.selected_or_first_available_variant -%}
          {%- if set_variant != blank -%}
            {%- if item_index > 0 -%},{%- endif -%}
            {
              "id": {{ set_variant.id | json }},
              "quantity": 1
            }
            {%- assign item_index = item_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    </script>

    <div class="apiarian-discovery-set__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'apiarian-discovery-set__image',
            loading: 'lazy',
            widths: '550, 750, 900, 1100, 1400, 1800',
            sizes: '(max-width: 989px) 100vw, 50vw'
        }}
      {% else %}
        <div class="apiarian-discovery-set__placeholder"></div>
      {% endif %}
    </div>

  </div>
</section>

<script>
  (function () {
    const section = document.querySelector(
      '#shopify-section-{{ section.id }} [data-apiarian-discovery-set]'
    );

    if (!section || section.dataset.cartInitialized === 'true') return;
    section.dataset.cartInitialized = 'true';

    const button = section.querySelector('[data-discovery-add]');
    const errorElement = section.querySelector('[data-discovery-cart-error]');
    const itemsElement = section.querySelector('[data-discovery-items]');

    if (!button || !itemsElement) return;

    let items = [];

    try {
      items = JSON.parse(itemsElement.textContent || '[]');
    } catch (error) {
      items = [];
    }

    button.addEventListener('click', function () {
      if (!items.length || button.disabled) return;

      const cartDrawer = document.querySelector('cart-drawer');
      const cartNotification = document.querySelector('cart-notification');
      const cart = cartDrawer || cartNotification;

      const payload = {
        items: items
      };

      if (cart && typeof cart.getSectionsToRender === 'function') {
        payload.sections = cart.getSectionsToRender().map(function (sectionItem) {
          return sectionItem.id;
        });
        payload.sections_url = window.location.pathname;
      }

      button.classList.add('is-loading');
      button.disabled = true;

      if (errorElement) {
        errorElement.textContent = '';
        errorElement.classList.remove('is-visible');
      }

      fetch(
        window.routes && window.routes.cart_add_url
          ? window.routes.cart_add_url
          : '/cart/add.js',
        {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        }
      )
        .then(function (response) {
          return response.json().then(function (data) {
            if (!response.ok || data.status) {
              throw new Error(
                data.description ||
                data.message ||
                'Unable to add this set to cart.'
              );
            }

            return data;
          });
        })
        .then(function (data) {
          if (cart && typeof cart.renderContents === 'function') {
            /*
              Dawn renders the new CartDrawer HTML here.
              If the cart was empty before this add, the outer
              <cart-drawer> can still keep the `is-empty` class.
              That class hides the populated drawer body even though
              the footer/total has already updated.
            */
            cart.renderContents(data);

            if (cart.classList.contains('is-empty')) {
              cart.classList.remove('is-empty');
            }

            const drawerItems = cart.querySelector('cart-drawer-items');
            if (drawerItems && drawerItems.classList.contains('is-empty')) {
              drawerItems.classList.remove('is-empty');
            }

            return;
          }

          if (cartDrawer && typeof cartDrawer.open === 'function') {
            if (cartDrawer.classList.contains('is-empty')) {
              cartDrawer.classList.remove('is-empty');
            }

            cartDrawer.open(button);
            return;
          }

          window.location.href =
            window.routes && window.routes.cart_url
              ? window.routes.cart_url
              : '/cart';
        })
        .catch(function (error) {
          if (errorElement) {
            errorElement.textContent = error.message;
            errorElement.classList.add('is-visible');
          }
        })
        .finally(function () {
          button.classList.remove('is-loading');
          button.disabled = false;
        });
    });
  })();
</script>

<script>
  (function () {
    const section = document.querySelector(
      '#shopify-section-{{ section.id }} [data-apiarian-discovery-set]'
    );

    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    ) {
      return;
    }

    const rect = section.getBoundingClientRect();
    const viewportHeight =
      window.innerHeight || document.documentElement.clientHeight;

    if (rect.top <= viewportHeight * 0.94) return;

    section.classList.add('is-animation-ready');

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;

          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -4% 0px'
      }
    );

    observer.observe(section);
  })();
</script>

{% schema %}
{
  "name": "Apiarian Discovery Set",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NOT SURE YET"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Try all five first, <em>then commit.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The Colony Discovery Set holds five 2 mL bottles, tester strips and a guided journey through the hive. The $28 is credited toward your first full bottle.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add the set"
    },
