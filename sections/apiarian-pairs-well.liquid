{% comment %}
  Section: Apiarian Pairs Well
  Collection-based products section
  - Shows products from the selected collection
  - Desktop grid
  - Mobile slider with pagination
  - Optional autoplay from settings
{% endcomment %}

{%- liquid
  assign pairs_collection = section.settings.products_collection
  assign link_product_count = pairs_collection.products_count | default: section.settings.products_limit
  assign link_product_count_word = link_product_count

  case link_product_count
    when 0
      assign link_product_count_word = 'zero'
    when 1
      assign link_product_count_word = 'one'
    when 2
      assign link_product_count_word = 'two'
    when 3
      assign link_product_count_word = 'three'
    when 4
      assign link_product_count_word = 'four'
    when 5
      assign link_product_count_word = 'five'
    when 6
      assign link_product_count_word = 'six'
    when 7
      assign link_product_count_word = 'seven'
    when 8
      assign link_product_count_word = 'eight'
    when 9
      assign link_product_count_word = 'nine'
    when 10
      assign link_product_count_word = 'ten'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well,
  #shopify-section-{{ section.id }} .apiarian-pairs-well * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.5px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__heading em {
    font-style: italic;
    font-family: "Bodoni Moda", serif;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_size }}px;
    font-weight: 400;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity .25s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__link:hover {
    opacity: .7;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__viewport {
    width: 100%;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
    transition: transform .4s ease;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__card {
    display: block;
    flex: 0 0 calc((100% - ({{ section.settings.card_gap }}px * 2)) / 3);
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1.12;
    overflow: hidden;
    padding: 0;
    border-radius: {{ section.settings.card_radius }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__card:nth-child(3n + 1) .apiarian-pairs-well__media {
    background: {{ section.settings.card_background_1 }};
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__card:nth-child(3n + 2) .apiarian-pairs-well__media {
    background: {{ section.settings.card_background_2 }};
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__card:nth-child(3n + 3) .apiarian-pairs-well__media {
    background: {{ section.settings.card_background_3 }};
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
    transition:
      opacity .38s ease,
      transform .45s cubic-bezier(.22, 1, .36, 1);
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__image--preview {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well__card.has-preview-image:hover .apiarian-pairs-well__image--primary {
      opacity: 0;
      transform: scale(1.015);
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__card.has-preview-image:hover .apiarian-pairs-well__image--preview {
      opacity: 1;
      transform: scale(1.02);
    }

    /* Products without a second image keep the existing subtle hover effect. */
    #shopify-section-{{ section.id }} .apiarian-pairs-well__card:not(.has-preview-image):hover .apiarian-pairs-well__image--primary {
      transform: scale(1.02);
    }
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__content {
    padding-top: 14px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__price {
    margin: 0;
    color: {{ section.settings.price_color }};
    font-size: {{ section.settings.price_size }}px;
    font-weight: 400;
    line-height: 1.25;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__tags {
    margin: 10px 0 0;
    color: {{ section.settings.tags_color }};
    font-size: {{ section.settings.tags_size }}px;
    font-weight: 300;
    line-height: 1.45;
    display: flex;
    gap: 7px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__pagination {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__pagination.is-visible {
    display: flex;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(42, 33, 24, 0.2);
    cursor: pointer;
    transition: background-color .25s ease, transform .25s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__dot.is-active {
    background: {{ section.settings.link_color }};
    transform: scale(1.1);
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__header,
  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__viewport,
  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__pagination {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .45s ease, transform .6s cubic-bezier(.22, 1, .36, 1);
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__viewport {
    transition-delay: .06s;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__pagination {
    transition-delay: .10s;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready.is-visible .apiarian-pairs-well__header,
  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready.is-visible .apiarian-pairs-well__viewport,
  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready.is-visible .apiarian-pairs-well__pagination {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well__track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__card {
      flex-basis: auto;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__pagination {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__header {
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 18px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__link {
      font-size: {{ section.settings.mobile_link_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__viewport {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__track {
      display: flex;
      gap: {{ section.settings.mobile_card_gap }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__card {
      flex-basis: {{ section.settings.mobile_card_width }}%;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__media {
      padding: 0;
      border-radius: {{ section.settings.mobile_card_radius }}px;
      aspect-ratio: 1 / 1.08;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__title {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__price {
      font-size: {{ section.settings.mobile_price_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__tags {
      font-size: {{ section.settings.mobile_tags_size }}px;
      margin-top: 8px;
    }

  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well__pagination {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__header,
    #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__viewport,
    #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__pagination {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__track {
      transition: none;
    }
  }
{% endstyle %}

<section
  class="apiarian-pairs-well"
  data-apiarian-pairs-well
  data-mobile-breakpoint="749"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
>
  <div class="page-width">
    <div class="apiarian-pairs-well__header">
      {% if section.settings.heading != blank %}
        <h2 class="apiarian-pairs-well__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <a
        href="{% if section.settings.link_url != blank %}{{ section.settings.link_url }}{% elsif pairs_collection != blank %}{{ pairs_collection.url }}{% else %}#pdp{% endif %}"
        class="apiarian-pairs-well__link"
        data-pairs-link
      >
        <span data-pairs-link-text>
          {{ section.settings.link_prefix }} {{ link_product_count_word }} {{ section.settings.link_suffix }}
        </span>
      </a>
    </div>

    <div class="apiarian-pairs-well__viewport" data-pairs-viewport>
      <div class="apiarian-pairs-well__track" data-recommended-products>
        {%- if pairs_collection != blank -%}
          {%- assign rendered_products = 0 -%}
          {%- for card_product in pairs_collection.products -%}
            {%- if rendered_products >= section.settings.products_limit -%}
              {%- break -%}
            {%- endif -%}

            {%- if product != blank and card_product.id == product.id -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign rendered_products = rendered_products | plus: 1 -%}
            {%- assign primary_image = card_product.featured_image -%}
            {%- assign preview_image = card_product.images[1] -%}

            <a
              href="{{ card_product.url }}"
              class="apiarian-pairs-well__card{% if preview_image != blank %} has-preview-image{% endif %}"
            >
              <div class="apiarian-pairs-well__media">
                {%- if primary_image != blank -%}
                  {{
                    primary_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 800, 900',
                      class: 'apiarian-pairs-well__image apiarian-pairs-well__image--primary',
                      alt: card_product.title
                  }}
                {%- endif -%}

                {%- if preview_image != blank -%}
                  {{
                    preview_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 800, 900',
                      class: 'apiarian-pairs-well__image apiarian-pairs-well__image--preview',
                      alt: ''
                  }}
                {%- endif -%}
              </div>

              <div class="apiarian-pairs-well__content">
                <div class="apiarian-pairs-well__meta">
                  <h3 class="apiarian-pairs-well__title">
                    {{ card_product.title | escape }}
                  </h3>

                  <p class="apiarian-pairs-well__price">
                    {{ section.settings.price_prefix }}{{ card_product.price_min | money_without_trailing_zeros }}
                  </p>
                </div>

                {%- assign custom_product_tags = card_product.metafields.custom.custom_porudct_tag.value -%}
                {%- if custom_product_tags.size > 0 -%}
                  <p class="apiarian-pairs-well__tags">
                    {%- for product_tag in custom_product_tags limit: 3 -%}
                     <span> {{- product_tag | escape -}}{%- unless forloop.last -%}, {%- endunless -%}</span>
                    {%- endfor -%}
                  </p>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="apiarian-pairs-well__pagination" data-pairs-pagination></div>
  </div>
</section>

<script>
  (function () {
    function initApiarianPairsWell(scope) {
      const root = (scope || document).querySelector(
        '#shopify-section-{{ section.id }} [data-apiarian-pairs-well]'
      );

      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const grid = root.querySelector('[data-recommended-products]');
      const viewport = root.querySelector('[data-pairs-viewport]');
      const pagination = root.querySelector('[data-pairs-pagination]');

      if (!grid) {
        root.hidden = true;
        return;
      }

      const autoplayEnabled = root.dataset.autoplay === 'true';
      const autoplaySpeed = parseInt(root.dataset.autoplaySpeed || '4', 10) * 1000;

      let sliderIndex = 0;
      let autoplayTimer = null;
      let cards = [];

      function clearAutoplay() {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function getPerView() {
        if (window.innerWidth <= 749) return 1;
        if (window.innerWidth <= 989) return 2;
        return 3;
      }

      function getPageCount() {
        const perView = getPerView();
        return Math.max(1, Math.ceil(cards.length / perView));
      }

      function renderPagination() {
        if (!pagination) return;

        pagination.innerHTML = '';

        const pageCount = getPageCount();

        if (cards.length <= getPerView() || pageCount <= 1) {
          pagination.classList.remove('is-visible');
          return;
        }

        pagination.classList.add('is-visible');

        for (let index = 0; index < pageCount; index += 1) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className =
            'apiarian-pairs-well__dot' +
            (index === sliderIndex ? ' is-active' : '');

          dot.setAttribute(
            'aria-label',
            'Go to products page ' + (index + 1)
          );

          dot.addEventListener('click', function () {
            sliderIndex = index;
            updateSlider();
            restartAutoplay();
          });

          pagination.appendChild(dot);
        }
      }

      function updateSlider() {
        if (!grid) return;

        cards = Array.from(
          grid.querySelectorAll('.apiarian-pairs-well__card')
        );

        if (!cards.length) return;

        const perView = getPerView();
        const pageCount = getPageCount();

        if (window.innerWidth > 749) {
          grid.style.transform = '';
          if (pagination) {
            pagination.classList.remove('is-visible');
            pagination.innerHTML = '';
          }
          return;
        }

        if (sliderIndex > pageCount - 1) {
          sliderIndex = pageCount - 1;
        }

        if (sliderIndex < 0) {
          sliderIndex = 0;
        }

        const firstCard = cards[0];
        const cardWidth = firstCard.getBoundingClientRect().width;
        const styles = window.getComputedStyle(grid);
        const gap = parseFloat(
          styles.columnGap || styles.gap || 0
        );

        const startCardIndex = sliderIndex * perView;
        const offset = startCardIndex * (cardWidth + gap);

        grid.style.transform =
          'translate3d(' + (-offset) + 'px, 0, 0)';

        renderPagination();

        Array.from(pagination.children).forEach(
          function (dot, index) {
            dot.classList.toggle(
              'is-active',
              index === sliderIndex
            );
          }
        );
      }

      function restartAutoplay() {
        clearAutoplay();

        /*
          Autoplay remains a mobile option, as requested.
          Desktop/tablet pagination works manually.
        */
        if (
          !autoplayEnabled ||
          window.innerWidth > 749 ||
          getPageCount() <= 1
        ) {
          return;
        }

        autoplayTimer = window.setInterval(function () {
          sliderIndex =
            (sliderIndex + 1) % getPageCount();

          updateSlider();
        }, Math.max(autoplaySpeed, 2000));
      }

      function goNext() {
        const pageCount = getPageCount();
        if (pageCount <= 1) return;

        sliderIndex =
          (sliderIndex + 1) % pageCount;

        updateSlider();
        restartAutoplay();
      }

      function goPrevious() {
        const pageCount = getPageCount();
        if (pageCount <= 1) return;

        sliderIndex =
          (sliderIndex - 1 + pageCount) % pageCount;

        updateSlider();
        restartAutoplay();
      }

      function bindSliderEvents() {
        if (!viewport) return;

        let touchStartX = 0;

        viewport.addEventListener(
          'touchstart',
          function (event) {
            clearAutoplay();

            if (event.touches && event.touches.length) {
              touchStartX = event.touches[0].clientX;
            }
          },
          { passive: true }
        );

        viewport.addEventListener(
          'touchend',
          function (event) {
            if (
              window.innerWidth <= 749 &&
              event.changedTouches &&
              event.changedTouches.length
            ) {
              const touchEndX =
                event.changedTouches[0].clientX;

              const difference =
                touchEndX - touchStartX;

              if (Math.abs(difference) > 45) {
                if (difference < 0) {
                  goNext();
                } else {
                  goPrevious();
                }

                return;
              }
            }

            restartAutoplay();
          },
          { passive: true }
        );

        viewport.addEventListener(
          'mouseenter',
          clearAutoplay
        );

        viewport.addEventListener(
          'mouseleave',
          restartAutoplay
        );
      }

      cards = Array.from(
        grid.querySelectorAll('.apiarian-pairs-well__card')
      );

      if (!cards.length) {
        root.hidden = true;
        return;
      }

      sliderIndex = 0;
      updateSlider();
      bindSliderEvents();
      restartAutoplay();

      let resizeTimer = null;
      window.addEventListener('resize', function () {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(function () {
          sliderIndex = 0;
          updateSlider();
          restartAutoplay();
        }, 100);
      });

      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        return;
      }

      const rect = root.getBoundingClientRect();
      const viewportHeight =
        window.innerHeight ||
        document.documentElement.clientHeight;

      if (rect.top <= viewportHeight * 0.94) {
        return;
      }

      root.classList.add('is-animation-ready');

      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -4% 0px'
        }
      );

      observer.observe(root);
    }

    initApiarianPairsWell(document);

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.id === 'shopify-section-{{ section.id }}') {
        const root = event.target.querySelector('[data-apiarian-pairs-well]');

        if (root) {
          delete root.dataset.initialized;
          root.hidden = false;
          root.classList.remove('is-animation-ready', 'is-visible');

          const pagination = root.querySelector('[data-pairs-pagination]');

          if (pagination) pagination.innerHTML = '';
        }

        initApiarianPairsWell(event.target);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Pairs well with",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well <em>with.</em>"
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products collection"
    },
    {
      "type": "text",
      "id": "link_prefix",
      "label": "Link prefix",
      "default": "All "
    },
    {
      "type": "text",
      "id": "link_suffix",
      "label": "Link suffix",
      "default": " scents"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From "
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Recommended products limit",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
