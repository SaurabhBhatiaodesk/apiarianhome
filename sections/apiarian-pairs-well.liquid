{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well,
  #shopify-section-{{ section.id }} .apiarian-pairs-well * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.5px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__heading em {
    font-style: italic;
    font-family: "Bodoni Moda", serif;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.link_size }}px;
    font-weight: 400;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity .25s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__link:hover {
    opacity: .7;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__viewport {
    width: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__track {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    transition: transform .4s ease;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__card {
    display: block;
    flex: 0 0 calc((100% - ({{ section.settings.card_gap }}px * 2)) / 3);
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1.12;
    overflow: hidden;
    padding: 0;
    border-radius: {{ section.settings.card_radius }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__card:nth-child(3n + 1) .apiarian-pairs-well__media {
    background: {{ section.settings.card_background_1 }};
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__card:nth-child(3n + 2) .apiarian-pairs-well__media {
    background: {{ section.settings.card_background_2 }};
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__card:nth-child(3n + 3) .apiarian-pairs-well__media {
    background: {{ section.settings.card_background_3 }};
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
    transition:
      opacity .38s ease,
      transform .45s cubic-bezier(.22, 1, .36, 1);
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__image--preview {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well__card.has-preview-image:hover .apiarian-pairs-well__image--primary {
      opacity: 0;
      transform: scale(1.015);
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__card.has-preview-image:hover .apiarian-pairs-well__image--preview {
      opacity: 1;
      transform: scale(1.02);
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__card:not(.has-preview-image):hover .apiarian-pairs-well__image--primary {
      transform: scale(1.02);
    }
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__content {
    padding-top: 14px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__price {
    margin: 0;
    color: {{ section.settings.price_color }};
    font-size: {{ section.settings.price_size }}px;
    font-weight: 400;
    line-height: 1.25;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__tags {
    margin: 10px 0 0;
    color: {{ section.settings.tags_color }};
    font-size: {{ section.settings.tags_size }}px;
    font-weight: 300;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__pagination {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__pagination.is-visible {
    display: flex;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(42, 33, 24, 0.2);
    cursor: pointer;
    transition:
      background-color .25s ease,
      transform .25s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well__dot.is-active {
    background: {{ section.settings.link_color }};
    transform: scale(1.1);
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__header,
  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__viewport,
  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__pagination {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity .45s ease,
      transform .6s cubic-bezier(.22, 1, .36, 1);
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__viewport {
    transition-delay: .06s;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__pagination {
    transition-delay: .10s;
  }

  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready.is-visible .apiarian-pairs-well__header,
  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready.is-visible .apiarian-pairs-well__viewport,
  #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready.is-visible .apiarian-pairs-well__pagination {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 989px) and (min-width: 750px) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well__card {
      flex-basis: calc((100% - {{ section.settings.card_gap }}px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__header {
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 18px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__link {
      font-size: {{ section.settings.mobile_link_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__track {
      gap: {{ section.settings.mobile_card_gap }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__card {
      flex-basis: {{ section.settings.mobile_card_width }}%;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__media {
      padding: 0;
      border-radius: {{ section.settings.mobile_card_radius }}px;
      aspect-ratio: 1 / 1.08;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__title {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__price {
      font-size: {{ section.settings.mobile_price_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__tags {
      font-size: {{ section.settings.mobile_tags_size }}px;
      margin-top: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__header,
    #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__viewport,
    #shopify-section-{{ section.id }} .apiarian-pairs-well.is-animation-ready .apiarian-pairs-well__pagination {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #shopify-section-{{ section.id }} .apiarian-pairs-well__track {
      transition: none;
    }
  }
{% endstyle %}

<section
  class="apiarian-pairs-well"
  data-apiarian-pairs-well
  data-product-id="{{ product.id }}"
  data-products-limit="{{ section.settings.products_limit }}"
  data-link-prefix="{{ section.settings.link_prefix | escape }}"
  data-link-suffix="{{ section.settings.link_suffix | escape }}"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
>
  <div class="page-width">
    <div class="apiarian-pairs-well__header">
      {% if section.settings.heading != blank %}
        <h2 class="apiarian-pairs-well__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <a
        href="{% if section.settings.link_url != blank %}{{ section.settings.link_url }}{% else %}#pdp{% endif %}"
        class="apiarian-pairs-well__link"
        data-pairs-link
      >
        <span data-pairs-link-text>
          {{ section.settings.link_prefix }}
          {{ section.settings.products_limit | default: 5 }}
          {{ section.settings.link_suffix }}
        </span>
      </a>
    </div>

    <div
      class="apiarian-pairs-well__viewport"
      data-pairs-viewport
    >
      <div
        class="apiarian-pairs-well__track"
        data-recommended-products
      >
        {% if recommendations.performed and recommendations.products_count > 0 %}
          {% for recommended_product in recommendations.products limit: section.settings.products_limit %}
            {% liquid
              assign tag_source_product = recommended_product

              assign tag_source_metafield = recommended_product.metafields.custom.source_product

              if tag_source_metafield != blank
                if tag_source_metafield.type contains 'list.product_reference'
                  assign tag_source_product = tag_source_metafield.value | first
                elsif tag_source_metafield.type contains 'product_reference'
                  assign tag_source_product = tag_source_metafield.value
                endif
              endif

              if tag_source_product == blank
                assign tag_source_product = recommended_product
              endif

              assign custom_product_tags = recommended_product.metafields.custom.custom_porudct_tag.value

              if custom_product_tags == blank
                assign custom_product_tags = tag_source_product.metafields.custom.custom_porudct_tag.value
              endif

              assign preview_image = recommended_product.images[1]
            %}

            <a
              href="{{ recommended_product.url }}"
              class="apiarian-pairs-well__card{% if preview_image != blank %} has-preview-image{% endif %}"
            >
              <div class="apiarian-pairs-well__media">
                {% if recommended_product.featured_image != blank %}
                  <img
                    class="apiarian-pairs-well__image apiarian-pairs-well__image--primary"
                    src="{{ recommended_product.featured_image | image_url: width: 1200 }}"
                    alt="{{ recommended_product.featured_image.alt | default: recommended_product.title | escape }}"
                    width="{{ recommended_product.featured_image.width }}"
                    height="{{ recommended_product.featured_image.height }}"
                    loading="lazy"
                  >
                {% endif %}

                {% if preview_image != blank %}
                  <img
                    class="apiarian-pairs-well__image apiarian-pairs-well__image--preview"
                    src="{{ preview_image | image_url: width: 1200 }}"
                    alt=""
                    width="{{ preview_image.width }}"
                    height="{{ preview_image.height }}"
                    loading="lazy"
                    aria-hidden="true"
                  >
                {% endif %}
              </div>

              <div class="apiarian-pairs-well__content">
                <div class="apiarian-pairs-well__meta">
                  <h3 class="apiarian-pairs-well__title">
                    {{ recommended_product.title | escape }}
                  </h3>

                  <p class="apiarian-pairs-well__price">
                    {{ section.settings.price_prefix }}{{ recommended_product.price_min | money_without_trailing_zeros }}
                  </p>
                </div>

                {% if custom_product_tags != blank %}
                  <p class="apiarian-pairs-well__tags">
                    {% for tag in custom_product_tags limit: 3 %}
                      {% if tag != blank %}
                        {{ tag | escape }}{% unless forloop.last %}, {% endunless %}
                      {% endif %}
                    {% endfor %}
                  </p>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div
      class="apiarian-pairs-well__pagination"
      data-pairs-pagination
    ></div>
  </div>
</section>

<script>
  (function () {
    function initApiarianPairsWell(scope) {
      const root = (scope || document).querySelector(
        '#shopify-section-{{ section.id }} [data-apiarian-pairs-well]'
      );

      if (!root || root.dataset.initialized === 'true') return;

      root.dataset.initialized = 'true';

      const productId = root.dataset.productId;
      const grid = root.querySelector('[data-recommended-products]');
      const viewport = root.querySelector('[data-pairs-viewport]');
      const pagination = root.querySelector('[data-pairs-pagination]');
      const linkText = root.querySelector('[data-pairs-link-text]');

      if (!productId || !grid) {
        root.hidden = true;
        return;
      }

      const productsLimit = parseInt(
        root.dataset.productsLimit || '5',
        10
      );

      const linkPrefix =
        root.dataset.linkPrefix || '';

      const linkSuffix =
        root.dataset.linkSuffix || '';

      const autoplayEnabled =
        root.dataset.autoplay === 'true';

      const autoplaySpeed =
        parseInt(root.dataset.autoplaySpeed || '4', 10) * 1000;

      let sliderIndex = 0;
      let autoplayTimer = null;
      let cards = [];

      function numberToWord(value) {
        const words = {
          0: 'zero',
          1: 'one',
          2: 'two',
          3: 'three',
          4: 'four',
          5: 'five',
          6: 'six',
          7: 'seven',
          8: 'eight',
          9: 'nine',
          10: 'ten'
        };

        return words[value] || String(value);
      }

      function updateLinkCount(count) {
        if (!linkText) return;

        linkText.textContent =
          linkPrefix.trim() +
          ' ' +
          numberToWord(count) +
          ' ' +
          linkSuffix.trim();
      }

      function clearAutoplay() {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function getPerView() {
        if (window.innerWidth <= 749) return 1;
        if (window.innerWidth <= 989) return 2;
        return 3;
      }

      function getPageCount() {
        const perView = getPerView();

        return Math.max(
          1,
          Math.ceil(cards.length / perView)
        );
      }

      function renderPagination() {
        if (!pagination) return;

        pagination.innerHTML = '';

        const pageCount = getPageCount();

        if (
          cards.length <= getPerView() ||
          pageCount <= 1
        ) {
          pagination.classList.remove('is-visible');
          return;
        }

        pagination.classList.add('is-visible');

        for (
          let index = 0;
          index < pageCount;
          index += 1
        ) {
          const dot = document.createElement('button');

          dot.type = 'button';

          dot.className =
            'apiarian-pairs-well__dot' +
            (index === sliderIndex ? ' is-active' : '');

          dot.setAttribute(
            'aria-label',
            'Go to products page ' + (index + 1)
          );

          dot.addEventListener(
            'click',
            function () {
              sliderIndex = index;

              updateSlider();
              restartAutoplay();
            }
          );

          pagination.appendChild(dot);
        }
      }

      function updateSlider() {
        if (!grid) return;

        cards = Array.from(
          grid.querySelectorAll(
            '.apiarian-pairs-well__card'
          )
        );

        if (!cards.length) return;

        const perView = getPerView();
        const pageCount = getPageCount();

        if (sliderIndex > pageCount - 1) {
          sliderIndex = pageCount - 1;
        }

        if (sliderIndex < 0) {
          sliderIndex = 0;
        }

        const firstCard = cards[0];

        const cardWidth =
          firstCard.getBoundingClientRect().width;

        const styles =
          window.getComputedStyle(grid);

        const gap =
          parseFloat(
            styles.columnGap ||
            styles.gap ||
            0
          );

        const startCardIndex =
          sliderIndex * perView;

        const offset =
          startCardIndex * (cardWidth + gap);

        grid.style.transform =
          'translate3d(' +
          (-offset) +
          'px, 0, 0)';

        renderPagination();

        if (pagination) {
          Array.from(
            pagination.children
          ).forEach(
            function (dot, index) {
              dot.classList.toggle(
                'is-active',
                index === sliderIndex
              );
            }
          );
        }
      }

      function restartAutoplay() {
        clearAutoplay();

        if (
          !autoplayEnabled ||
          window.innerWidth > 749 ||
          getPageCount() <= 1
        ) {
          return;
        }

        autoplayTimer =
          window.setInterval(
            function () {
              sliderIndex =
                (sliderIndex + 1) %
                getPageCount();

              updateSlider();
            },
            Math.max(
              autoplaySpeed,
              2000
            )
          );
      }

      function goNext() {
        const pageCount = getPageCount();

        if (pageCount <= 1) return;

        sliderIndex =
          (sliderIndex + 1) %
          pageCount;

        updateSlider();
        restartAutoplay();
      }

      function goPrevious() {
        const pageCount = getPageCount();

        if (pageCount <= 1) return;

        sliderIndex =
          (
            sliderIndex -
            1 +
            pageCount
          ) %
          pageCount;

        updateSlider();
        restartAutoplay();
      }

      function bindSliderEvents() {
        if (!viewport) return;

        let touchStartX = 0;

        viewport.addEventListener(
          'touchstart',
          function (event) {
            clearAutoplay();

            if (
              event.touches &&
              event.touches.length
            ) {
              touchStartX =
                event.touches[0].clientX;
            }
          },
          {
            passive: true
          }
        );

        viewport.addEventListener(
          'touchend',
          function (event) {
            if (
              window.innerWidth <= 749 &&
              event.changedTouches &&
              event.changedTouches.length
            ) {
              const touchEndX =
                event.changedTouches[0].clientX;

              const difference =
                touchEndX -
                touchStartX;

              if (
                Math.abs(difference) > 45
              ) {
                if (difference < 0) {
                  goNext();
                } else {
                  goPrevious();
                }

                return;
              }
            }

            restartAutoplay();
          },
          {
            passive: true
          }
        );

        viewport.addEventListener(
          'mouseenter',
          clearAutoplay
        );

        viewport.addEventListener(
          'mouseleave',
          restartAutoplay
        );
      }

      function setupAnimation() {
        if (
          window
            .matchMedia(
              '(prefers-reduced-motion: reduce)'
            )
            .matches ||
          !(
            'IntersectionObserver' in
            window
          )
        ) {
          return;
        }

        const rect =
          root.getBoundingClientRect();

        const viewportHeight =
          window.innerHeight ||
          document.documentElement.clientHeight;

        if (
          rect.top <=
          viewportHeight * 0.94
        ) {
          return;
        }

        root.classList.add(
          'is-animation-ready'
        );

        const observer =
          new IntersectionObserver(
            function (entries) {
              entries.forEach(
                function (entry) {
                  if (
                    !entry.isIntersecting
                  ) {
                    return;
                  }

                  entry.target.classList.add(
                    'is-visible'
                  );

                  observer.unobserve(
                    entry.target
                  );
                }
              );
            },
            {
              threshold: 0.12,
              rootMargin:
                '0px 0px -4% 0px'
            }
          );

        observer.observe(root);
      }

      function initialiseCards() {
        cards = Array.from(
          grid.querySelectorAll(
            '.apiarian-pairs-well__card'
          )
        );

        if (!cards.length) {
          root.hidden = true;
          return;
        }

        root.hidden = false;

        updateLinkCount(cards.length);

        sliderIndex = 0;

        updateSlider();
        bindSliderEvents();
        restartAutoplay();
        setupAnimation();
      }

      if (
        grid.querySelector(
          '.apiarian-pairs-well__card'
        )
      ) {
        initialiseCards();
        return;
      }

      const recommendationsUrl =
        '{{ routes.product_recommendations_url }}' +
        '?section_id={{ section.id }}' +
        '&product_id=' +
        encodeURIComponent(productId) +
        '&limit=' +
        encodeURIComponent(productsLimit) +
        '&intent=related';

      fetch(recommendationsUrl)
        .then(function (response) {
          if (!response.ok) {
            throw new Error(
              'Unable to load recommended products'
            );
          }

          return response.text();
        })
        .then(function (htmlText) {
          const parser =
            new DOMParser();

          const documentHtml =
            parser.parseFromString(
              htmlText,
              'text/html'
            );

          const recommendedGrid =
            documentHtml.querySelector(
              '[data-recommended-products]'
            );

          if (!recommendedGrid) {
            root.hidden = true;
            return;
          }

          const recommendedCards =
            recommendedGrid.querySelectorAll(
              '.apiarian-pairs-well__card'
            );

          if (!recommendedCards.length) {
            root.hidden = true;
            return;
          }

          grid.innerHTML =
            recommendedGrid.innerHTML;

          initialiseCards();
        })
        .catch(function () {
          root.hidden = true;
        });

      let resizeTimer = null;

      window.addEventListener(
        'resize',
        function () {
          window.clearTimeout(
            resizeTimer
          );

          resizeTimer =
            window.setTimeout(
              function () {
                sliderIndex = 0;

                updateSlider();
                restartAutoplay();
              },
              100
            );
        }
      );
    }

    initApiarianPairsWell(document);

    document.addEventListener(
      'shopify:section:load',
      function (event) {
        if (
          event.target &&
          event.target.id ===
            'shopify-section-{{ section.id }}'
        ) {
          const root =
            event.target.querySelector(
              '[data-apiarian-pairs-well]'
            );

          if (root) {
            delete root.dataset.initialized;

            root.hidden = false;

            root.classList.remove(
              'is-animation-ready',
              'is-visible'
            );

            const grid =
              root.querySelector(
                '[data-recommended-products]'
              );

            const pagination =
              root.querySelector(
                '[data-pairs-pagination]'
              );

            if (grid) {
              grid.innerHTML = '';
            }

            if (pagination) {
              pagination.innerHTML = '';
            }
          }

          initApiarianPairsWell(
            event.target
          );
        }
      }
    );
  })();
</script>

