{% comment %}
  Section: Apiarian Good To Know
  Two-column heading + accordion section.
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know,
  #shopify-section-{{ section.id }} .apiarian-good-to-know * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__inner {
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    gap: 70px;
    align-items: start;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__intro,
  #shopify-section-{{ section.id }} .apiarian-good-to-know__accordion {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__eyebrow {
    margin: 0 0 20px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.8px;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__heading em {
    font-family:"Bodoni Moda", serif;
    font-style: italic;
    /* font-weight: 400; */
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__accordion {
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__item {
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__button {
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    margin: 0;
    padding:20px 0;
    border: 0;
    background: transparent;
    color: {{ section.settings.question_color }};
    font-family: inherit;
    font-size: {{ section.settings.question_size }}px;
    font-weight: 400;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__icon {
    position: relative;
    flex: 0 0 11px;
    width: 11px;
    height: 11px;
    font-size: 0;
    color: {{ section.settings.icon_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__icon::before,
  #shopify-section-{{ section.id }} .apiarian-good-to-know__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform .25s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  #shopify-section-{{ section.id }}
  .apiarian-good-to-know__button[aria-expanded="true"]
  .apiarian-good-to-know__icon::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  #shopify-section-{{ section.id }}
  .apiarian-good-to-know__button[aria-expanded="true"]
  .apiarian-good-to-know__icon::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .3s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__item.is-open
  .apiarian-good-to-know__answer {
    grid-template-rows: 1fr;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__answer-inner {
    min-height: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__answer-content {
    max-width: 720px;
    padding: 0 42px 22px 0;
    color: {{ section.settings.answer_color }};
    font-size: {{ section.settings.answer_size }}px;
    font-weight: 300;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know__answer-content p {
    margin: 0;
  }

  /* lightweight page-on-scroll animation */
  #shopify-section-{{ section.id }} .apiarian-good-to-know.is-animation-ready
  .apiarian-good-to-know__intro,
  #shopify-section-{{ section.id }} .apiarian-good-to-know.is-animation-ready
  .apiarian-good-to-know__accordion {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity .45s ease,
      transform .6s cubic-bezier(.22, 1, .36, 1);
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know.is-animation-ready
  .apiarian-good-to-know__accordion {
    transition-delay: .08s;
  }

  #shopify-section-{{ section.id }} .apiarian-good-to-know.is-animation-ready.is-visible
  .apiarian-good-to-know__intro,
  #shopify-section-{{ section.id }} .apiarian-good-to-know.is-animation-ready.is-visible
  .apiarian-good-to-know__accordion {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .apiarian-good-to-know__inner {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__intro,
    #shopify-section-{{ section.id }} .apiarian-good-to-know__accordion {
      min-width: 0;
      width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .apiarian-good-to-know {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__inner {
      gap: 34px;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__eyebrow {
      margin-bottom: 20px;
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
      letter-spacing: {{ section.settings.mobile_eyebrow_letter_spacing }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__button {
      padding: 22px 0;
      font-size: {{ section.settings.mobile_question_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__answer-content {
      max-width: none;
      padding: 0 28px 24px 0;
      font-size: {{ section.settings.mobile_answer_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__heading,
    #shopify-section-{{ section.id }} .apiarian-good-to-know__button,
    #shopify-section-{{ section.id }} .apiarian-good-to-know__answer-content {
      overflow-wrap: anywhere;
    }
  }

  @media screen and (max-width: 479px) {
    #shopify-section-{{ section.id }} .apiarian-good-to-know__inner {
      gap: 28px;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__button {
      gap: 14px;
      padding: 20px 0;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__answer-content {
      padding-right: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .apiarian-good-to-know.is-animation-ready
    .apiarian-good-to-know__intro,
    #shopify-section-{{ section.id }} .apiarian-good-to-know.is-animation-ready
    .apiarian-good-to-know__accordion {
      opacity: 1;
      transform: none;
      transition: none;
    }

    #shopify-section-{{ section.id }} .apiarian-good-to-know__answer {
      transition: none;
    }
  }
{% endstyle %}

<section
  class="apiarian-good-to-know"
  data-apiarian-good-to-know
>
  <div class="page-width">
    <div class="apiarian-good-to-know__inner">

      <div class="apiarian-good-to-know__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="apiarian-good-to-know__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank or section.settings.heading_italic != blank %}
        <h2 class="apiarian-good-to-know__heading">
          {{ section.settings.heading | escape }}
          {% if section.settings.heading_italic != blank %}
            <em>{{ section.settings.heading_italic | escape }}</em>
          {% endif %}
        </h2>
      {% endif %}
    </div>

    <div class="apiarian-good-to-know__accordion">
      {% for block in section.blocks %}
        {%- assign open_item = false -%}
        {%- if forloop.first and section.settings.first_open -%}
          {%- assign open_item = true -%}
        {%- endif -%}

        <div
          class="apiarian-good-to-know__item{% if open_item %} is-open{% endif %}"
          data-accordion-item
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="apiarian-good-to-know__button"
            data-accordion-button
            aria-expanded="{% if open_item %}true{% else %}false{% endif %}"
            aria-controls="Accordion-{{ section.id }}-{{ block.id }}"
          >
            <span>{{ block.settings.question | escape }}</span>
            <span class="apiarian-good-to-know__icon" aria-hidden="true"></span>
          </button>

          <div
            id="Accordion-{{ section.id }}-{{ block.id }}"
            class="apiarian-good-to-know__answer"
            data-accordion-answer
          >
            <div class="apiarian-good-to-know__answer-inner">
              {% if block.settings.answer != blank %}
                <div class="apiarian-good-to-know__answer-content">
                  {{ block.settings.answer }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    function initGoodToKnow() {
      const section = document.querySelector(
        '#shopify-section-{{ section.id }} [data-apiarian-good-to-know]'
      );

      if (!section || section.dataset.initialized === 'true') return;
      section.dataset.initialized = 'true';

      const items = section.querySelectorAll('[data-accordion-item]');

      items.forEach(function (item) {
        const button = item.querySelector('[data-accordion-button]');

        if (!button) return;

        button.addEventListener('click', function () {
          const isOpen = item.classList.contains('is-open');

          items.forEach(function (otherItem) {
            const otherButton = otherItem.querySelector('[data-accordion-button]');

            otherItem.classList.remove('is-open');

            if (otherButton) {
              otherButton.setAttribute('aria-expanded', 'false');
            }
          });

          if (!isOpen) {
            item.classList.add('is-open');
            button.setAttribute('aria-expanded', 'true');
          }
        });
      });

      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        return;
      }

      const rect = section.getBoundingClientRect();
      const viewportHeight =
        window.innerHeight ||
        document.documentElement.clientHeight;

      if (rect.top <= viewportHeight * 0.94) return;

      section.classList.add('is-animation-ready');

      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;

            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -4% 0px'
        }
      );

      observer.observe(section);
    }

    initGoodToKnow();

    document.addEventListener('shopify:section:load', function (event) {
      if (
        event.target &&
        event.target.id === 'shopify-section-{{ section.id }}'
      ) {
        const section = event.target.querySelector('[data-apiarian-good-to-know]');

        if (section) {
          delete section.dataset.initialized;
          section.classList.remove('is-animation-ready', 'is-visible');
        }

        initGoodToKnow();
      }
    });
  })();
</script>

