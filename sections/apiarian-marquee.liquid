{% style %}
#shopify-section-{{ section.id }} {
  background: {{ section.settings.background_color }};
}

#shopify-section-{{ section.id }} .apiarian-marquee,
#shopify-section-{{ section.id }} .apiarian-marquee * {
  box-sizing: border-box;
}

#shopify-section-{{ section.id }} .apiarian-marquee {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
}

#shopify-section-{{ section.id }} .apiarian-marquee__track {
  display: flex;
  width: max-content;
  min-width: 100%;
  will-change: transform;
  animation:
    apiarianMarquee{{ section.id }}
    {{ section.settings.speed }}s
    linear
    infinite;
}

#shopify-section-{{ section.id }} .apiarian-marquee:hover .apiarian-marquee__track {
  {% if section.settings.pause_on_hover %}
    animation-play-state: paused;
  {% endif %}
}

#shopify-section-{{ section.id }} .apiarian-marquee__group {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: max-content;
}

#shopify-section-{{ section.id }} .apiarian-marquee__item {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  min-height: {{ section.settings.height }}px;
  padding: 0 {{ section.settings.item_gap | divided_by: 2 }}px;

  color: {{ section.settings.text_color }};

  font-size: {{ section.settings.font_size }}px;
  font-weight: {{ section.settings.font_weight }};
  line-height: 1;
  letter-spacing: {{ section.settings.letter_spacing }}px;
  text-transform: uppercase;
  white-space: nowrap;
}

#shopify-section-{{ section.id }} .apiarian-marquee__dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  padding: 0 {{ section.settings.dot_gap }}px;

  color: {{ section.settings.text_color }};

  font-size: {{ section.settings.dot_size }}px;
  line-height: 1;
  opacity: {{ section.settings.dot_opacity | divided_by: 100.0 }};
}

@keyframes apiarianMarquee{{ section.id }} {
  from {
    transform: translate3d(0, 0, 0);
  }

  to {
    transform: translate3d(-50%, 0, 0);
  }
}

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .apiarian-marquee__item {
    min-height: {{ section.settings.mobile_height }}px;
    padding: 0 {{ section.settings.mobile_item_gap | divided_by: 2 }}px;

    font-size: {{ section.settings.mobile_font_size }}px;
    letter-spacing: {{ section.settings.mobile_letter_spacing }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-marquee__dot {
    padding: 0 {{ section.settings.mobile_dot_gap }}px;
    font-size: {{ section.settings.mobile_dot_size }}px;
  }
}

@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .apiarian-marquee__track {
    animation: none;
    transform: none;
  }
}
{% endstyle %}

<section
  class="apiarian-marquee"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="apiarian-marquee__track">

    {% for duplicate in (1..2) %}
      <div
        class="apiarian-marquee__group"
        {% if duplicate == 2 %}
          aria-hidden="true"
        {% endif %}
      >

        {% for block in section.blocks %}
          {% if block.settings.text != blank %}
            <span
              class="apiarian-marquee__item"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text | escape }}
            </span>

            <span
              class="apiarian-marquee__dot"
              aria-hidden="true"
            >
              {{ section.settings.separator }}
            </span>
          {% endif %}
        {% endfor %}

      </div>
    {% endfor %}

  </div>
</section>

{% schema %}
{
  "name": "Apiarian Marquee",
  "tag": "section",
  "class": "section-apiarian-marquee",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Marquee"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "•"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Store highlights"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#EED38F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#33271D"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Bar height",
      "min": 36,
      "max": 90,
      "step": 1,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "400",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 6,
      "step": 0.2,
      "unit": "px",
      "default": 2.8
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Text side gap",
      "min": 10,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "dot_gap",
      "label": "Separator side gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Separator size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "dot_opacity",
      "label": "Separator opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Bar height",
      "min": 32,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.2,
      "unit": "px",
      "default": 2.2
    },
    {
      "type": "range",
      "id": "mobile_item_gap",
      "label": "Text side gap",
      "min": 8,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_dot_gap",
      "label": "Separator side gap",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_dot_size",
      "label": "Separator size",
      "min": 7,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 9
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Marquee text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "BEESWAX-INFUSED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Apiarian Marquee",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "A PORTION OF EVERY SALE FUNDS POLLINATORS"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "BEESWAX-INFUSED"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "NOTHING SYNTHETIC"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "HAND POURED IN SMALL BATCHES"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "FREE U.S. SHIPPING"
          }
        }
      ]
    }
  ]
}
{% endschema %}
