{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.section_background }};
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing,
  #shopify-section-{{ section.id }} .apiarian-room-pairing * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 72px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__eyebrow {
    color: {{ section.settings.accent_color }};
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__heading {
    max-width: 18ch;
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;
    line-height: 1.06;
    letter-spacing: -0.018em;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__heading em,
  #shopify-section-{{ section.id }} .apiarian-room-pairing__heading i {
    font-family: "Bodoni Moda", serif;
    font-style: italic;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__text {
    max-width: 44ch;
    margin: 0;
    color: {{ section.settings.body_color }};
    font-size: 18px;
    font-weight: 300;
    line-height: 1.62;
  }
  #shopify-section-{{ section.id }} .apiarian-room-pairing__text p{
    margin:0; 
    padding:0;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__list {
    display: grid;
    gap: 0;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__row {
    display: grid;
    grid-template-columns: 22px 1fr 1.5fr auto;
    gap: 22px;
    align-items: center;
    padding: 22px 0;
    border-top: 1px solid rgba(42, 33, 24, 0.16);
    text-decoration: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__row:last-child {
    border-bottom: 1px solid rgba(42, 33, 24, 0.16);
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__swatch {
    display: block;
    width: 22px;
    height: 25px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__room {
    font-size:18px;
    font-weight: 400;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__description {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.4;
    color: {{ section.settings.body_color }};
  }

  #shopify-section-{{ section.id }} .apiarian-room-pairing__label {
    font-size: 16px;
    letter-spacing: 0.04em;
    color: {{ section.settings.accent_color }};
    text-align: right;
    white-space: nowrap;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .apiarian-room-pairing__layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .apiarian-room-pairing {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-room-pairing__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-room-pairing__text {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .apiarian-room-pairing__row {
      grid-template-columns: 18px 1fr;
      grid-template-areas:
        "swatch room"
        ". description"
        ". label";
      row-gap: 6px;
      column-gap: 16px;
      padding: 18px 0;
    }

    #shopify-section-{{ section.id }} .apiarian-room-pairing__swatch {
      grid-area: swatch;
      width: 18px;
      height: 20px;
    }

    #shopify-section-{{ section.id }} .apiarian-room-pairing__room {
      grid-area: room;
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .apiarian-room-pairing__description {
      grid-area: description;
      font-size: 15px;
    }

    #shopify-section-{{ section.id }} .apiarian-room-pairing__label {
      grid-area: label;
      text-align: left;
      font-size: 13px;
    }
  }
{% endstyle %}

<section class="apiarian-room-pairing">
  <div class="page-width">
    <div class="apiarian-room-pairing__layout">
      <div class="apiarian-room-pairing__intro">
        {% if section.settings.eyebrow != blank %}
          <div class="apiarian-room-pairing__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="apiarian-room-pairing__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="apiarian-room-pairing__text">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      <div class="apiarian-room-pairing__list">
        {% for block in section.blocks %}
          {% liquid
            assign row_product = block.settings.product
            assign row_color = block.settings.accent_color
            if row_product != blank and row_color == blank
              assign row_color = row_product.metafields.custom.product_badge_color.value
            endif
            assign row_color = row_color | default: section.settings.fallback_color
            assign row_label = block.settings.label | default: row_product.title
            assign row_url = row_product.url | default: block.settings.link
            assign row_description = block.settings.description
            if row_description == blank
              assign row_description = row_product.metafields.custom.product_caption.value | default: row_product.description
            endif
          %}
          {% if row_url != blank %}
            <a href="{{ row_url }}" class="apiarian-room-pairing__row" {{ block.shopify_attributes }}>
          {% else %}
            <span class="apiarian-room-pairing__row" {{ block.shopify_attributes }}>
          {% endif %}
            <span class="apiarian-room-pairing__swatch" style="background: {{ row_color }};"></span>
            <span class="apiarian-room-pairing__room">{{ block.settings.room | escape }}</span>
            <span class="apiarian-room-pairing__description">{{ row_description | strip_html | escape }}</span>
            <span class="apiarian-room-pairing__label">{{ row_label | escape }}</span>
          {% if row_url != blank %}
            </a>
          {% else %}
            </span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Room pairing guide",
  "tag": "section",
  "class": "section-apiarian-room-pairing",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Where each one goes"
