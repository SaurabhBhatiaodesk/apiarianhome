      "label": "Heading",
      "default": "Pick by room, <em>not by mood.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Beeswax holds scent longest on fabric, so the room that suits a blend is usually the one with the most cloth in it.</p>"
    },
    {
      "type": "color",
      "id": "fallback_color",
      "label": "Fallback swatch color",
      "default": "#C79A3C"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
