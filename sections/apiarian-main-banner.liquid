{% style %}

  /* ==============================
     SECTION
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner,
  #shopify-section-{{ section.id }} .apiarian-main-banner * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.fallback_background }};
  }


  /* ==============================
     IMAGE
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.desktop_image_position }};
  }


  /* ==============================
     OVERLAY
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner__overlay {
    display: block;

    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    z-index: 1;

    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, {{ section.settings.left_overlay | divided_by: 100.0 }}) 0%,
        rgba(0, 0, 0, {{ section.settings.center_overlay | divided_by: 100.0 }}) 50%,
        rgba(0, 0, 0, {{ section.settings.right_overlay | divided_by: 100.0 }}) 100%
      );

    pointer-events: none;
  }


  /* ==============================
     CONTENT AREA
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner__inner {
    position: relative;
    z-index: 2;

    width: 100%;

    padding:
      {{ section.settings.padding_top }}px
      0
      {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__page-width {
    display: flex;
    justify-content: flex-end;
    align-items: center;

    width: 100%;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__content {
    width: 100%;
    max-width: {{ section.settings.content_width }}px;

    text-align: right;
  }


  /* ==============================
     EYEBROW
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner__eyebrow {
    margin: 0 0 24px;

    color: {{ section.settings.eyebrow_color }};
    font-size: 15.074px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }


  /* ==============================
     HEADING
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner__heading {
    margin: 0 0 28px;

    color: {{ section.settings.heading_color }};

    font-size: {{ section.settings.heading_size }}px;
    font-weight: 300;
    line-height: 1;

    letter-spacing: -1.5px;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__heading em,
  #shopify-section-{{ section.id }} .apiarian-main-banner__heading i {
    font-style: italic;
    font-weight: 400;
    font-family: "Bodoni Moda", serif;
  }


  /* ==============================
     DESCRIPTION
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner__description {
    width: 100%;
    max-width: {{ section.settings.description_width }}px;

    margin-left: auto;

    color: {{ section.settings.description_color }};

    font-size: {{ section.settings.description_size }}px;
    font-weight: 300;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__description p {
    margin: 0;
  }


  /* ==============================
     BUTTON
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner__button-wrap {
    margin-top: 30px;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding:18px 31px;

    border: 1px solid {{ section.settings.button_background }};
    border-radius: 999px;

    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text }};

    text-decoration: none;

    font-size: 15px;
    font-weight: 400;
    line-height: 1;

    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__button:hover {
    background: {{ section.settings.button_hover_background }};
    border-color: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text }};

    transform: translateY(-2px);
  }




  /* ==============================
     LIGHTWEIGHT PAGE LOAD ANIMATION
     Image is visible immediately.
     Only subtle movement is used.
  ============================== */

  #shopify-section-{{ section.id }} .apiarian-main-banner__image {
    animation:
      apiarianBannerImage{{ section.id }}
      1.1s
      cubic-bezier(0.22, 1, 0.36, 1)
      both;
    transform-origin: center center;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__eyebrow {
    animation:
      apiarianBannerContent{{ section.id }}
      0.52s
      ease-out
      0.04s
      both;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__heading {
    animation:
      apiarianBannerContent{{ section.id }}
      0.58s
      cubic-bezier(0.22, 1, 0.36, 1)
      0.09s
      both;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__description {
    animation:
      apiarianBannerContent{{ section.id }}
      0.58s
      cubic-bezier(0.22, 1, 0.36, 1)
      0.14s
      both;
  }

  #shopify-section-{{ section.id }} .apiarian-main-banner__button-wrap {
    animation:
      apiarianBannerContent{{ section.id }}
      0.58s
      cubic-bezier(0.22, 1, 0.36, 1)
      0.19s
      both;
  }

  @keyframes apiarianBannerImage{{ section.id }} {
    from {
      transform: scale(1.035);
    }

    to {
      transform: scale(1);
    }
  }

  @keyframes apiarianBannerContent{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .apiarian-main-banner__image,
    #shopify-section-{{ section.id }} .apiarian-main-banner__eyebrow,
    #shopify-section-{{ section.id }} .apiarian-main-banner__heading,
    #shopify-section-{{ section.id }} .apiarian-main-banner__description,
    #shopify-section-{{ section.id }} .apiarian-main-banner__button-wrap {
      animation: none;
    }
  }

  /* ==============================
     TABLET
  ============================== */

  @media screen and (max-width: 990px) {

    #shopify-section-{{ section.id }} .apiarian-main-banner__inner {
      padding-left: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__heading {
      font-size: 58px;
    }

  }


  /* ==============================
     MOBILE
  ============================== */

  @media screen and (max-width: 749px) {

    #shopify-section-{{ section.id }} .apiarian-main-banner__image {
      object-position: {{ section.settings.mobile_image_position }};
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__overlay {
      background:
        linear-gradient(
          0deg,
          rgba(0, 0, 0, 0.72) 0%,
          rgba(0, 0, 0, 0.32) 58%,
          rgba(0, 0, 0, 0.12) 100%
        );
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__inner {
      padding:
        {{ section.settings.mobile_padding_top }}px
        0
        {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__page-width {
      justify-content: flex-start;
      align-items: flex-end;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__content {
      max-width: 100%;

      text-align: left;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__content {
      padding-right: 4px;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__eyebrow {
      margin-bottom: 16px;

      font-size: 12px;
      letter-spacing: 4px;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__heading {
      max-width: 520px;
      margin-bottom: 18px;

      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.04;

      letter-spacing: -0.6px;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__description {
      max-width: 520px;
      margin-left: 0;

      font-size: {{ section.settings.mobile_description_size }}px;
      line-height: 1.55;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__button-wrap {
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__button {
      min-height: 50px;

      padding: 11px 27px;

      font-size: 14px;
    }

  }



  @media screen and (max-width: 420px) {

    #shopify-section-{{ section.id }} .apiarian-main-banner__inner {
      padding-left: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__heading {
      font-size: calc({{ section.settings.mobile_heading_size }}px - 2px);
    }

    #shopify-section-{{ section.id }} .apiarian-main-banner__button {
      min-height: 48px;
      padding-left: 24px;
      padding-right: 24px;
    }

  }

{% endstyle %}


<section class="apiarian-main-banner">

  <!-- Background -->
  <div class="apiarian-main-banner__media">

    {% if section.settings.background_image != blank %}

      <img
        class="apiarian-main-banner__image"
        src="{{ section.settings.background_image | image_url: width: 1800 }}"
        srcset="
          {{ section.settings.background_image | image_url: width: 750 }} 750w,
          {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.background_image | image_url: width: 1600 }} 1600w,
          {{ section.settings.background_image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
        loading="eager"
        alt="{{ section.settings.background_image.alt | escape }}"
      >

    {% endif %}

  </div>


  <!-- Overlay -->
  <div
    class="apiarian-main-banner__overlay"
    aria-hidden="true"
  ></div>


  <!-- Content -->
  <div class="apiarian-main-banner__inner">

    <div class="page-width apiarian-main-banner__page-width">

    <div class="apiarian-main-banner__content">

      {% if section.settings.eyebrow != blank %}
        <p class="apiarian-main-banner__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank %}
        <div class="apiarian-main-banner__heading">
          {{ section.settings.heading }}
        </div>
      {% endif %}


      {% if section.settings.description != blank %}
        <div class="apiarian-main-banner__description">
          {{ section.settings.description }}
        </div>
      {% endif %}


      {% if section.settings.button_label != blank %}

        <div class="apiarian-main-banner__button-wrap">

          {% if section.settings.button_link != blank %}

            <a
              href="{{ section.settings.button_link }}"
              class="apiarian-main-banner__button"
            >
              {{ section.settings.button_label | escape }}
            </a>

          {% else %}

            <span class="apiarian-main-banner__button">
              {{ section.settings.button_label | escape }}
            </span>

          {% endif %}

        </div>

      {% endif %}

    </div>

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Apiarian Main Banner",
  "tag": "section",
  "class": "section-apiarian-main-banner",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE COLLECTION"
    },

    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Fragrance from <em>the hive.</em>"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Five beeswax-infused home fragrances, each built on a role in the colony.</p>"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },


    {
      "type": "header",
      "content": "Background image"
    },

    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },

    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "center center",
      "options": [
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ]
    },

    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "default": "center center",
      "options": [
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Right"
        }
