{% comment %} 
  CHOOSE YOUR SCENT 
  Select up to 5 scent products from block settings.
  Swatch backgrounds come from product metafield: custom.product_badge_color.
{% endcomment %} 

<style> 
  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}, 
  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }} * { 
    box-sizing: border-box; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }} { 
    width: 100%; 
    min-width: 0; 
    margin: 0 0 0 0; 
    color: {{ block.settings.text_color }}; 
    container-type: inline-size; 
    container-name: choose-scent-{{ block.id }}; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__header { 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    gap: 20px; 
    padding-bottom: 9px; 
    border-bottom: 1px solid #d8d0c6; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__heading, 
  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__count { 
    margin: 0; 
    font-weight: 400; 
    line-height: 1.3; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__heading { 
    color: {{ block.settings.heading_color }}; 
    font-size: 12.8289px; 
    letter-spacing: 0.16em; 
    text-transform: uppercase; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__count { 
    color:#6b5a3e; 
    font-size: 13.1497px; 
    white-space: nowrap; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__products { 
    display: grid; 
    grid-template-columns: repeat(5, minmax(0, 1fr)); 
    gap: 8px; 
    margin-top: 14px; 
    width: 100%; 
    min-width: 0; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__item { 
    display: block; 
    min-width: 0; 
    color: inherit; 
    text-align: center; 
    text-decoration: none; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__media-wrap { 
    position: relative; 
    width: 100%; 
    padding: 3px; 
    border: 1px solid transparent; 
    border-radius: 12px; 
    transition: border-color .25s ease, transform .25s ease; 
    display:flex; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__media { 
    display: block; 
    width: 100%; 
    height: 43px; 
    overflow: hidden; 
    border-radius: 12px; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__item.is-selected 
  .choose-your-scent-{{ block.id }}__media-wrap { 
    border-color:{{ block.settings.text_color }}; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__name { 
    display: block; 
    margin-top: 8px; 
    color:{{ block.settings.text_color }}; 
    font-size:13px; 
    font-weight: 400; 
    line-height: 1.3; 
  } 

  #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__item.is-selected 
  .choose-your-scent-{{ block.id }}__name { 
    color: {{ block.settings.text_color }}; 
  } 

  #shopify-section-{{ section.id }} 
  .choose-your-scent-{{ block.id }}.is-animation-ready 
  .choose-your-scent-{{ block.id }}__header, 
  #shopify-section-{{ section.id }} 
  .choose-your-scent-{{ block.id }}.is-animation-ready 
  .choose-your-scent-{{ block.id }}__products { 
    opacity: 0; 
    transform: translateY(14px); 
    transition: opacity .45s ease, transform .6s cubic-bezier(.22,1,.36,1); 
  } 

  #shopify-section-{{ section.id }} 
  .choose-your-scent-{{ block.id }}.is-animation-ready.is-visible 
  .choose-your-scent-{{ block.id }}__header, 
  #shopify-section-{{ section.id }} 
  .choose-your-scent-{{ block.id }}.is-animation-ready.is-visible 
  .choose-your-scent-{{ block.id }}__products { 
    opacity: 1; 
    transform: translateY(0); 
  } 

  @media screen and (max-width: 749px) { 
    #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }} { 
      margin: 30px 0 15px; 
    } 

    #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__header { 
      gap: 10px; 
      padding-bottom: 12px; 
    } 

    #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__heading { 
      font-size: 12px; 
      letter-spacing: 1.4px; 
    } 

    #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__count { 
      font-size: 11px; 
    } 

    #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__products { 
      grid-template-columns: repeat(5, minmax(0, 1fr)); 
      gap: 6px; 
      margin-top: 12px; 
    } 

    #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__media-wrap { 
      width: 100%; 
      padding: 2px; 
      border-radius: 8px; 
    } 

    #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__media { 
      width: 100%; 
      height: 38px; 
      border-radius: 8px; 
    } 

    #shopify-section-{{ section.id }} .choose-your-scent-{{ block.id }}__name { 
      margin-top: 6px; 
      font-size: 11px; 
      line-height: 1.25; 
      text-align: center; 
      overflow-wrap: anywhere; 
    } 
  } 

  @media (prefers-reduced-motion: reduce) { 
    #shopify-section-{{ section.id }} 
    .choose-your-scent-{{ block.id }}.is-animation-ready 
    .choose-your-scent-{{ block.id }}__header, 
    #shopify-section-{{ section.id }} 
    .choose-your-scent-{{ block.id }}.is-animation-ready 
    .choose-your-scent-{{ block.id }}__products { 
      opacity: 1; 
      transform: none; 
      transition: none; 
    } 
  } 
</style> 

{%- liquid
  assign selected_products = block.settings.products
  assign display_count = selected_products.size
  if display_count > 5
    assign display_count = 5
  endif
-%}

{% if display_count > 0 %}
  <div
    class="choose-your-scent-{{ block.id }}"
    data-choose-your-scent
    {{ block.shopify_attributes }}
  >

    <div class="choose-your-scent-{{ block.id }}__header">

      {% if block.settings.heading != blank %}
        <p class="choose-your-scent-{{ block.id }}__heading">
          {{ block.settings.heading | escape }}
        </p>
      {% endif %}

      {% if block.settings.count_text != blank %}
        <p class="choose-your-scent-{{ block.id }}__count">
          {% case display_count %}
            {% when 1 %}One
            {% when 2 %}Two
            {% when 3 %}Three
            {% when 4 %}Four
            {% when 5 %}Five
            {% else %}{{ display_count }}
          {% endcase %}
          {{ block.settings.count_text | escape }}
        </p>
      {% endif %}

    </div>

    <div class="choose-your-scent-{{ block.id }}__products">

      {% for scent_product in selected_products limit: 5 %}
        {%- liquid
          assign scent_badge_color = scent_product.metafields.custom.product_badge_color.value

          if scent_badge_color == blank
            assign scent_handle_1 = scent_product.handle
            assign scent_handle_2 = scent_product.handle | remove: '-fragrance'
            assign scent_handle_3 = scent_product.title | handleize
            assign scent_handle_4 = scent_handle_3 | remove: '-fragrance'
            assign scent_handle_5 = scent_handle_4 | remove_first: 'the-'

            if scent_handle_2 != scent_handle_1
              assign scent_source_product = all_products[scent_handle_2]
            endif

            if scent_source_product == blank and scent_handle_4 != scent_handle_1
              assign scent_source_product = all_products[scent_handle_4]
            endif

            if scent_source_product == blank and scent_handle_5 != scent_handle_1
              assign scent_source_product = all_products[scent_handle_5]
            endif

            if scent_source_product != blank
              assign scent_badge_color = scent_source_product.metafields.custom.product_badge_color.value
            endif
          endif

          assign is_selected = false
          assign current_handle_base = product.handle | remove: '-fragrance' | remove_first: 'the-'
          assign scent_handle_base = scent_product.handle | remove: '-fragrance' | remove_first: 'the-'

          if scent_product.id == product.id or scent_handle_base == current_handle_base
            assign is_selected = true
          endif
        -%}

            <a
              href="{{ scent_product.url }}"
              class="choose-your-scent-{{ block.id }}__item{% if is_selected %} is-selected{% endif %}"
              {% if is_selected %}aria-current="page"{% endif %}
            >
              <span class="choose-your-scent-{{ block.id }}__media-wrap">
                <span
                  class="choose-your-scent-{{ block.id }}__media"
                  {% if scent_badge_color != blank %}
                    style="background: {{ scent_badge_color }};"
                  {% endif %}
                ></span>
              </span>

              <span class="choose-your-scent-{{ block.id }}__name">
                {{ scent_product.title | escape }}
              </span>
            </a>
      {% endfor %}

    </div>

  </div>

  <script> 
    (function () { 
      const root = document.querySelector( 
        '#shopify-section-{{ section.id }} [data-choose-your-scent]' 
      ); 

      if (!root || root.dataset.initialized === 'true') return; 

      root.dataset.initialized = 'true'; 

      if ( 
        window.matchMedia('(prefers-reduced-motion: reduce)').matches || 
        !('IntersectionObserver' in window) 
      ) { 
        return; 
      } 

      const rect = root.getBoundingClientRect(); 

      const viewportHeight = 
        window.innerHeight || 
        document.documentElement.clientHeight; 

      if (rect.top <= viewportHeight * 0.94) { 
        return; 
      } 

      root.classList.add('is-animation-ready'); 

      const observer = new IntersectionObserver( 
        function (entries) { 
          entries.forEach(function (entry) { 
            if (!entry.isIntersecting) return; 

            entry.target.classList.add('is-visible'); 
            observer.unobserve(entry.target); 
          }); 
        }, 
        { 
          threshold: 0.12, 
          rootMargin: '0px 0px -4% 0px' 
        } 
      ); 

      observer.observe(root); 
    })(); 
  </script>
{% endif %}
