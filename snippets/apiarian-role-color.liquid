{%- doc -%}
  Resolves the display color for a product's role in the colony.

  Priority:
  1. Metaobject referenced by product metafield custom.the_role_in_the_colony
     (field: background_color, falling back to the misspelled backround_color)
  2. Product metafield custom.product_badge_color
  3. blank (caller should apply its own fallback)

  @param {object} product - Shopify product object.

  @return {string} A color value, or an empty string if none was found.
{%- enddoc -%}

{%- liquid
  assign role_metafield = product.metafields.custom.the_role_in_the_colony
  assign role_entry = blank

  if role_metafield != blank
    if role_metafield.type contains 'list.metaobject_reference'
      assign role_entry = role_metafield.value | first
    elsif role_metafield.type contains 'metaobject_reference'
      assign role_entry = role_metafield.value
    else
      assign role_raw_value = role_metafield.value
      if role_raw_value != blank
        assign role_raw_handle = role_raw_value | handleize
        assign role_entry = shop.metaobjects.the_role_in_the_colony[role_raw_value]
        if role_entry == blank
          assign role_entry = shop.metaobjects.the_role_in_the_colony[role_raw_handle]
        endif
      endif
    endif
  endif

  assign resolved_color = ''

  if role_entry != blank
    assign resolved_color = role_entry.background_color.value
    if resolved_color == blank
      assign resolved_color = role_entry.backround_color.value
    endif
  endif

  if resolved_color == blank
    assign resolved_color = product.metafields.custom.product_badge_color.value
  endif
-%}{{ resolved_color }}
