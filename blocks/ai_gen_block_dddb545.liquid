{% doc %}
  @prompt
    Create a standalone featured testimonial/pullquote block for a premium bee-inspired home fragrance brand. The block should display a single stand-out customer review with: a large stylized quotation mark, the review text in elegant typography, a star rating display, and the reviewer's name with a subtle attribution line. Style it with warm cream and honey-gold tones, a spa-inspired modern apothecary aesthetic, and optional hexagonal or bee-themed decorative accents. The block settings should allow customization of the quote text, reviewer name, star rating, and accent color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-testimonial-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
    position: relative;
  }

  .ai-testimonial-quote-mark-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_mark_size }}px;
    line-height: 1;
    color: {{ block.settings.accent_color }};
    font-family: Georgia, serif;
    margin-bottom: {{ block.settings.quote_mark_spacing }}px;
    opacity: {{ block.settings.quote_mark_opacity | divided_by: 100.0 }};
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_font_size }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin-bottom: {{ block.settings.quote_spacing }}px;
    font-style: italic;
  }

  .ai-testimonial-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: {{ block.settings.rating_spacing }}px;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .ai-testimonial-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-star-{{ ai_gen_id }}.empty {
    color: {{ block.settings.star_empty_color }};
  }

  .ai-testimonial-attribution-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
    {% if block.settings.text_alignment == 'center' %}
      align-items: center;
    {% elsif block.settings.text_alignment == 'right' %}
      align-items: flex-end;
    {% else %}
      align-items: flex-start;
    {% endif %}
  }

  .ai-testimonial-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.name_color }};
    margin: 0;
  }

  .ai-testimonial-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_font_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-testimonial-hexagon-{{ ai_gen_id }} {
    position: absolute;
    opacity: {{ block.settings.hexagon_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-testimonial-hexagon-{{ ai_gen_id }}.top-left {
    top: -20px;
    left: -20px;
    width: {{ block.settings.hexagon_size }}px;
    height: {{ block.settings.hexagon_size }}px;
    transform: rotate(15deg);
  }

  .ai-testimonial-hexagon-{{ ai_gen_id }}.bottom-right {
    bottom: -30px;
    right: -30px;
    width: {{ block.settings.hexagon_size | times: 1.5 }}px;
    height: {{ block.settings.hexagon_size | times: 1.5 }}px;
    transform: rotate(-25deg);
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-testimonial-quote-mark-{{ ai_gen_id }} {
      font-size: {{ block.settings.quote_mark_size | times: 0.7 }}px;
    }

    .ai-testimonial-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.quote_font_size | times: 0.85 }}px;
    }

    .ai-testimonial-hexagon-{{ ai_gen_id }}.top-left,
    .ai-testimonial-hexagon-{{ ai_gen_id }}.bottom-right {
      display: none;
    }
  }
{% endstyle %}

<testimonial-block-{{ ai_gen_id }}
  class="ai-testimonial-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_hexagons %}
    <div class="ai-testimonial-hexagon-{{ ai_gen_id }} top-left">
      <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <polygon
          points="50 1 95 25 95 75 50 99 5 75 5 25"
          fill="none"
          stroke="{{ block.settings.accent_color }}"
          stroke-width="2"
        />
      </svg>
    </div>
    <div class="ai-testimonial-hexagon-{{ ai_gen_id }} bottom-right">
      <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <polygon
          points="50 1 95 25 95 75 50 99 5 75 5 25"
          fill="none"
          stroke="{{ block.settings.accent_color }}"
          stroke-width="1.5"
        />
      </svg>
    </div>
  {% endif %}

  <div class="ai-testimonial-container-{{ ai_gen_id }}">
    {% if block.settings.show_quote_mark %}
      <div class="ai-testimonial-quote-mark-{{ ai_gen_id }}">"</div>
    {% endif %}

    {% if block.settings.quote_text != blank %}
      <div class="ai-testimonial-text-{{ ai_gen_id }}">
        {{ block.settings.quote_text }}
      </div>
    {% endif %}

    {% if block.settings.show_rating %}
      <div class="ai-testimonial-rating-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% if i <= block.settings.star_rating %}
            <svg
              class="ai-testimonial-star-{{ ai_gen_id }}"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          {% else %}
            <svg
              class="ai-testimonial-star-{{ ai_gen_id }} empty"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="ai-testimonial-attribution-{{ ai_gen_id }}">
      {% if block.settings.reviewer_name != blank %}
        <div class="ai-testimonial-name-{{ ai_gen_id }}">
          {{ block.settings.reviewer_name }}
        </div>
      {% endif %}

      {% if block.settings.reviewer_subtitle != blank %}
        <div class="ai-testimonial-subtitle-{{ ai_gen_id }}">
          {{ block.settings.reviewer_subtitle }}
        </div>
      {% endif %}
    </div>
  </div>
</testimonial-block-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Featured testimonial",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "This fragrance transformed my home into a spa-like sanctuary. The honey notes are divine and the scent lasts for hours."
    },
    {
      "type": "text",
      "id": "reviewer_name",
      "label": "Reviewer name",
      "default": "Sarah M."
    },
    {
      "type": "text",
      "id": "reviewer_subtitle",
      "label": "Reviewer subtitle",
      "default": "Verified Customer"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Star rating",
      "default": 5
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Star size",
      "default": 20
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#c88a2b"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Empty star color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "rating_spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Rating spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Quote mark"
    },
    {
      "type": "checkbox",
      "id": "show_quote_mark",
      "label": "Show quote mark",
      "default": true
    },
    {
      "type": "range",
      "id": "quote_mark_size",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Quote mark size",
      "default": 80
    },
    {
      "type": "range",
      "id": "quote_mark_opacity",
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Quote mark opacity",
      "default": 30
    },
    {
      "type": "range",
      "id": "quote_mark_spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Quote mark spacing",
      "default": 16
    },
    {
      "type": "header",
      "content": "Hexagon accents"
    },
    {
      "type": "checkbox",
      "id": "show_hexagons",
      "label": "Show hexagon accents",
      "default": true
    },
    {
      "type": "range",
      "id": "hexagon_size",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Hexagon size",
      "default": 80
    },
    {
      "type": "range",
      "id": "hexagon_opacity",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Hexagon opacity",
      "default": 15
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Content max width",
      "default": 700
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Vertical padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "quote_spacing",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Quote spacing",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "quote_font_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Quote font size",
      "default": 20
    },
    {
      "type": "range",
      "id": "name_font_size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Name font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "min": 10,
      "max": 18,
      "step": 2,
      "unit": "px",
      "label": "Subtitle font size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f6f1e8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Quote text",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name",
      "default": "#11151c"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c88a2b"
    }
  ],
  "presets": [
    {
      "name": "Featured testimonial"
    }
  ]
}
{% endschema %}
