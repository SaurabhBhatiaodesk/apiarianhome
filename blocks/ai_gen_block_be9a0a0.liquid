{% doc %}
  @prompt
    I need a section where i can show different reviews horizontally (scroll right-to-left for more reviews...)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-scroll-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-scroll__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-reviews-scroll__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-reviews-scroll__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
    font-weight: 500;
  }

  .ai-reviews-scroll__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-reviews-scroll__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin: 0 -20px;
    padding: 0 20px;
  }

  .ai-reviews-scroll__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 20px;
  }

  .ai-reviews-scroll__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-reviews-scroll__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
    box-shadow: 0 {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
  }

  .ai-reviews-scroll__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
  }

  .ai-reviews-scroll__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-reviews-scroll__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.review_text_color }};
    margin-bottom: 20px;
  }

  .ai-reviews-scroll__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-reviews-scroll__avatar-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.avatar_text_color }};
    flex-shrink: 0;
  }

  .ai-reviews-scroll__author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-reviews-scroll__author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.author_name_color }};
    margin: 0 0 4px;
  }

  .ai-reviews-scroll__author-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_meta_size }}px;
    color: {{ block.settings.author_meta_color }};
    margin: 0;
  }

  .ai-reviews-scroll__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .ai-reviews-scroll__button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.button_background }};
    border: 1px solid {{ block.settings.button_border_color }};
    color: {{ block.settings.button_icon_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-reviews-scroll__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_icon_color }};
  }

  .ai-reviews-scroll__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-reviews-scroll__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.subheading_color }};
    font-size: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-scroll__card-{{ ai_gen_id }} {
      flex: 0 0 280px;
    }

    .ai-reviews-scroll__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<reviews-carousel-{{ ai_gen_id }}
  class="ai-reviews-scroll-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-reviews-scroll__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-reviews-scroll__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-reviews-scroll__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-reviews-scroll__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% assign has_reviews = false %}
    {% for i in (1..6) %}
      {% liquid
        assign review_text_key = 'review_' | append: i | append: '_text'
        assign review_text = block.settings[review_text_key]
        if review_text != blank
          assign has_reviews = true
          break
        endif
      %}
    {% endfor %}

    {% if has_reviews %}
      <div class="ai-reviews-scroll__wrapper-{{ ai_gen_id }}">
        <div class="ai-reviews-scroll__track-{{ ai_gen_id }}" data-track>
          {% for i in (1..6) %}
            {% liquid
              assign review_text_key = 'review_' | append: i | append: '_text'
              assign author_name_key = 'review_' | append: i | append: '_author_name'
              assign author_meta_key = 'review_' | append: i | append: '_author_meta'
              assign rating_key = 'review_' | append: i | append: '_rating'

              assign review_text = block.settings[review_text_key]
              assign author_name = block.settings[author_name_key]
              assign author_meta = block.settings[author_meta_key]
              assign rating = block.settings[rating_key]
            %}

            {% if review_text != blank %}
              <div class="ai-reviews-scroll__card-{{ ai_gen_id }}">
                <div class="ai-reviews-scroll__stars-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    <svg
                      class="ai-reviews-scroll__star-{{ ai_gen_id }}"
                      fill="{% if star <= rating %}currentColor{% else %}none{% endif %}"
                      stroke="currentColor"
                      stroke-width="1.5"
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
                      ></path>
                    </svg>
                  {% endfor %}
                </div>

                <div class="ai-reviews-scroll__text-{{ ai_gen_id }}">
                  {{ review_text }}
                </div>

                {% if author_name != blank or author_meta != blank %}
                  <div class="ai-reviews-scroll__author-{{ ai_gen_id }}">
                    {% if author_name != blank %}
                      <div class="ai-reviews-scroll__avatar-{{ ai_gen_id }}">
                        {{ author_name | slice: 0 | upcase }}
                      </div>
                    {% endif %}
                    <div class="ai-reviews-scroll__author-info-{{ ai_gen_id }}">
                      {% if author_name != blank %}
                        <div class="ai-reviews-scroll__author-name-{{ ai_gen_id }}">{{ author_name }}</div>
                      {% endif %}
                      {% if author_meta != blank %}
                        <div class="ai-reviews-scroll__author-meta-{{ ai_gen_id }}">{{ author_meta }}</div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if block.settings.show_controls %}
        <div class="ai-reviews-scroll__controls-{{ ai_gen_id }}">
          <button
            class="ai-reviews-scroll__button-{{ ai_gen_id }}"
            data-prev
            aria-label="Previous review"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            class="ai-reviews-scroll__button-{{ ai_gen_id }}"
            data-next
            aria-label="Next review"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-reviews-scroll__empty-{{ ai_gen_id }}">
        Add your first review to get started
      </div>
    {% endif %}
  </div>
</reviews-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');

        if (!this.track) return;

        this.setupEventListeners();
        this.updateButtonStates();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.scroll('prev'));
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.scroll('next'));
        }

        this.track.addEventListener('scroll', () => this.updateButtonStates());
      }

      scroll(direction) {
        const cardWidth = this.track.querySelector('.ai-reviews-scroll__card-{{ ai_gen_id }}').offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const scrollAmount = cardWidth + gap;

        if (direction === 'prev') {
          this.track.scrollLeft -= scrollAmount;
        } else {
          this.track.scrollLeft += scrollAmount;
        }
      }

      updateButtonStates() {
        if (!this.prevButton || !this.nextButton) return;

        const isAtStart = this.track.scrollLeft <= 0;
        const isAtEnd = this.track.scrollLeft + this.track.offsetWidth >= this.track.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('reviews-carousel-{{ ai_gen_id }}', ReviewsCarousel{{ ai_gen_id }});
  })();
</script>

